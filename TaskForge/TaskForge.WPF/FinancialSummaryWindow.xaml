<Window x:Class="TaskForge.WPF.FinancialSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TaskForge.WPF.Converters"
        Title="Financial Summary" Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
     Background="#F5F5F5"
        Loaded="Window_Loaded">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Ваш фінансовий звіт" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Button Grid.Row="1" 
          x:Name="AddExpenseButton"
         Content="Додати витрату"
      Height="40"
       Width="150"
              FontSize="14"
     Background="#FF9800"
        Foreground="White"
               BorderThickness="0"
   Command="{Binding AddExpenseCommand}"
             HorizontalAlignment="Left"
             Margin="0,0,0,15">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
    CornerRadius="5"
        BorderThickness="0">
                                            <ContentPresenter HorizontalAlignment="Center"
    VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F57C00"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="Список" FontSize="18" FontWeight="Medium" Margin="0,10,0,10"/>

                <ListView x:Name="ExpensesListView"
    ItemsSource="{Binding Expenses}"
           Visibility="{Binding IsExpensesListVisible, Converter={StaticResource BoolToVisibilityConverter}}"
               Background="White"
       BorderThickness="0"
     HorizontalContentAlignment="Stretch">

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#EEEEEE" BorderThickness="0,0,0,1" Padding="15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Description}" FontSize="16" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding Date, StringFormat={}{0:dd/MM}}" Foreground="Gray" Margin="0,0,10,0"/>
                                            <Border Background="#E0E0E0" CornerRadius="5" Padding="5,2">
                                                <TextBlock Text="{Binding Category}" Foreground="#424242" FontSize="10" FontWeight="Medium"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" 
      Orientation="Horizontal" 
            VerticalAlignment="Center" 
 HorizontalAlignment="Right" 
    Margin="20,0">
                                        <TextBlock 
          Text="{Binding Amount, StringFormat='-{0:F2}'}"
     FontSize="16"
      FontWeight="Bold"
           Foreground="#D32F2F"
         VerticalAlignment="Center"/>
                                        <TextBlock 
       Text="{Binding Currency}"
        FontSize="16"
            FontWeight="Bold"
            Foreground="#D32F2F"
           VerticalAlignment="Center"
    Margin="5,0,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
           Content="Видалити"
          Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
         CommandParameter="{Binding Id}"
     Background="#F44336"
           Foreground="White"
        BorderThickness="0"
          Padding="10,5"
       Margin="5,0"/>

                                    <Button Grid.Column="3"
       Content="Редагувати"
              Background="#9E9E9E"
     Command="{Binding DataContext.EditExpenseCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
          CommandParameter="{Binding Id}"
         Foreground="White"
        BorderThickness="0"
          Padding="10,5"
     Margin="5,0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="2" 
         Content="Закрити" 
    Width="100" 
                Height="35" 
                HorizontalAlignment="Right"
         Margin="0,20,0,0"
                Background="#757575"
   Foreground="White"
   BorderThickness="0"
     Command="{Binding CloseCommand}"/>

        <Grid x:Name="AddExpenseModalOverlay" 
        Grid.RowSpan="3"
          Visibility="{Binding IsAddExpenseModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
  Background="#80000000" 
    Panel.ZIndex="101">
            <Border Background="White" 
    CornerRadius="10" 
     Padding="30" 
           Width="400" 
  VerticalAlignment="Center" 
            HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Додати витрату" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Сума витрати:" Margin="0,0,0,5"/>
                    <TextBox x:Name="AddExpenseAmountBox" Text="{Binding AddExpenseAmount, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" Margin="0,0,0,15"/>

                    <TextBlock Text="Валюта:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="AddExpenseCurrencyBox" 
         ItemsSource="{Binding Currencies}" 
             SelectedItem="{Binding AddExpenseCurrency}" 
     Height="30" Margin="0,0,0,15"/>

                    <TextBlock Text="Категорія:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="AddExpenseCategoryBox" 
        ItemsSource="{Binding Categories}" 
          SelectedItem="{Binding AddExpenseCategory}" 
   Height="30" Margin="0,0,0,15"/>

                    <TextBlock Text="Дата:" Margin="0,0,0,5"/>
                    <DatePicker x:Name="AddExpenseDateBox" 
   SelectedDate="{Binding AddExpenseDate}" 
    Height="30" Margin="0,0,0,15"/>

                    <TextBlock Text="Опис:" Margin="0,0,0,5"/>
                    <TextBox x:Name="AddExpenseDescriptionBox" 
     Text="{Binding AddExpenseDescription, UpdateSourceTrigger=PropertyChanged}" 
           Height="60" Padding="5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Зберегти" Width="80" Height="35" Margin="0,0,10,0" Command="{Binding SaveAddExpenseCommand}" Background="#FF9800" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="Скасувати" Width="80" Height="35" Command="{Binding CancelAddExpenseCommand}" Background="#9E9E9E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="EditExpenseModalOverlay" 
   Grid.RowSpan="3"
       Visibility="{Binding IsEditExpenseModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
   Background="#80000000" 
              Panel.ZIndex="102">
            <Border Background="White" 
        CornerRadius="10" 
    Padding="30" 
   Width="400" 
       VerticalAlignment="Center" 
           HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Редагувати витрату" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Сума витрати:" Margin="0,0,0,5"/>
                    <TextBox x:Name="EditExpenseAmountBox" Text="{Binding EditExpenseAmount, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" Margin="0,0,0,15"/>

                    <TextBlock Text="Валюта:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="EditExpenseCurrencyBox" 
 ItemsSource="{Binding Currencies}" 
    SelectedItem="{Binding EditExpenseCurrency}" 
 Height="30" Margin="0,0,0,15"/>

                    <TextBlock Text="Категорія:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="EditExpenseCategoryBox" 
  ItemsSource="{Binding Categories}" 
   SelectedItem="{Binding EditExpenseCategory}" 
      Height="30" Margin="0,0,0,15"/>

                    <TextBlock Text="Дата:" Margin="0,0,0,5"/>
                    <DatePicker x:Name="EditExpenseDateBox" 
     SelectedDate="{Binding EditExpenseDate}" 
        Height="30" Margin="0,0,0,15"/>

                    <TextBlock Text="Опис:" Margin="0,0,0,5"/>
                    <TextBox x:Name="EditExpenseDescriptionBox" 
         Text="{Binding EditExpenseDescription, UpdateSourceTrigger=PropertyChanged}" 
       Height="60" Padding="5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Зберегти" Width="80" Height="35" Margin="0,0,10,0" Command="{Binding SaveEditExpenseCommand}" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="Скасувати" Width="80" Height="35" Command="{Binding CancelEditExpenseCommand}" Background="#9E9E9E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>