<Window x:Class="TaskForge.WPF.FinancialSummaryWindow"
        xmlns:enums="clr-namespace:TaskForge.Domain.Enums;assembly=TaskForge.Domain"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TaskForge.WPF.Converters"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="Трекер фінансів" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#222531"
        Loaded="Window_Loaded"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="40,30,40,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Ваш фінансовий звіт" 
                       FontSize="28" 
                       Foreground="White" 
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="+ Додати запис" 
                        Command="{Binding AddExpenseCommand}"
                        Width="120" Height="40"
                        Background="#4DB6AC" 
                        Foreground="White"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="40,0,40,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <Border Style="{StaticResource DashboardCardStyle}" Height="140" Margin="0,0,0,20">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Поточний баланс" Style="{StaticResource CardHeaderTextStyle}"/>
                        <TextBlock Text="{Binding CurrentBalance, StringFormat='{}{0:N1}₴'}" 
                                   FontSize="48" 
                                   Foreground="White" 
                                   FontWeight="Medium" 
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Height="140">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Витрати цього місяця" Style="{StaticResource CardHeaderTextStyle}"/>
                            <TextBlock Text="{Binding SpentThisMonth, StringFormat='{}{0:N1}₴'}" 
                                       FontSize="32" 
                                       Foreground="#EF5350" 
                                       FontWeight="Medium" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Height="140">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Дохід цього місяця" Style="{StaticResource CardHeaderTextStyle}"/>
                            <TextBlock Text="{Binding EarnedThisMonth, StringFormat='{}{0:N1}₴'}" 
                                       FontSize="32" 
                                       Foreground="#4DB6AC" 
                                       FontWeight="Medium" 
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}">
                <Grid>
                    <TextBlock Text="Pie chart витрат" 
                               Style="{StaticResource CardHeaderTextStyle}" 
                               Margin="0,20,0,0" 
                               VerticalAlignment="Top"/>

                    <lvc:PieChart Series="{Binding PieChartSeries}" 
                                  LegendLocation="None" 
                                  InnerRadius="0"
                                  HoverPushOut="5"
                                  Margin="20,50,20,20">
                        <lvc:PieChart.DataTooltip>
                            <lvc:DefaultTooltip SelectionMode="OnlySender" Background="#323645" Foreground="White"/>
                        </lvc:PieChart.DataTooltip>
                    </lvc:PieChart>
                </Grid>
            </Border>
        </Grid>

        <TextBlock Grid.Row="3" Text="Ваші записи" 
                   FontSize="20" 
                   Foreground="White" 
                   Margin="40,0,0,10"/>

        <ListView Grid.Row="4" 
                  ItemsSource="{Binding Expenses}" 
                  Background="Transparent" 
                  BorderThickness="0"
                  Margin="40,0,40,20"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Margin" Value="0,0,0,15"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="#323645" CornerRadius="5" Height="60" Padding="20,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Description}" 
                                           FontSize="16" 
                                           Foreground="White" 
                                           VerticalAlignment="Center" 
                                           Width="150" 
                                           TextTrimming="CharacterEllipsis"/>

                                <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                    <TextBlock Text="{Binding Date, StringFormat='{}{0:dd/MM}'}" 
                                               FontSize="12" 
                                               Foreground="#90A4AE"/>
                                </StackPanel>

                                <Border BorderBrush="#FF91F2" BorderThickness="1" CornerRadius="10" Padding="10,2"
                                        VerticalAlignment="Center" Margin="10,0,0,0"
                                        Visibility="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Expense}">
                                    <TextBlock Text="{Binding Category}" 
                                               FontSize="11" 
                                               Foreground="#FF91F2"/>
                                </Border>

                                <Border BorderBrush="#66BB6A" BorderThickness="1" CornerRadius="10" Padding="10,2"
                                        VerticalAlignment="Center" Margin="10,0,0,0"
                                        Visibility="{Binding Type, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=Income}">
                                    <TextBlock Text="Дохід" 
                                               FontSize="11" 
                                               Foreground="#66BB6A"/>
                                </Border>
                            </StackPanel>

                            <Border Grid.Column="1" 
                                    CornerRadius="4" 
                                    Padding="10,5" 
                                    Width="120"
                                    Margin="0,0,40,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                <Setter Property="Background" Value="#3E2723"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="Income">
                                                <Setter Property="Background" Value="#1B5E20"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                    <Setter Property="Foreground" Value="#EF5350"/>
                                                    <Setter Property="Text">
                                                        <Setter.Value>
                                                            <MultiBinding StringFormat="-{0:F2} {1}">
                                                                <Binding Path="Amount"/>
                                                                <Binding Path="Currency"/>
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Income">
                                                    <Setter Property="Foreground" Value="#66BB6A"/>
                                                    <Setter Property="Text">
                                                        <Setter.Value>
                                                            <MultiBinding StringFormat="+{0:F2} {1}">
                                                                <Binding Path="Amount"/>
                                                                <Binding Path="Currency"/>
                                                            </MultiBinding>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ActionIconButtonStyle}" 
                                        Command="{Binding DataContext.EditExpenseCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding Id}" 
                                        Margin="0,0,10,0"
                                        ToolTip="Edit">
                                    <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" 
                                          Fill="#B0BEC5" Stretch="Uniform" Width="16" Height="16"/>
                                </Button>

                                <Button Style="{StaticResource ActionIconButtonStyle}" 
                                        Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                        CommandParameter="{Binding Id}"
                                        ToolTip="Delete">
                                    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" 
                                          Fill="#B0BEC5" Stretch="Uniform" Width="16" Height="16"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid x:Name="AddExpenseModalOverlay" 
          Grid.RowSpan="5"
          Visibility="{Binding IsAddExpenseModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
          Background="#CC000000" Panel.ZIndex="100">

            <Border Background="#2B2F3E" CornerRadius="10" Padding="30" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Додати запис" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <RadioButton Content="Витрата" IsChecked="{Binding IsAddExpense}" GroupName="AddTypeGroup" Foreground="White" FontSize="16" Margin="0,0,20,0"/>
                        <RadioButton Content="Дохід" IsChecked="{Binding IsAddIncome}" GroupName="AddTypeGroup" Foreground="White" FontSize="16"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Сума" Style="{StaticResource ModalLabelStyle}"/>
                            <TextBox Text="{Binding AddExpenseAmount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Валюта" Style="{StaticResource ModalLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Currencies}" 
                                  SelectedItem="{Binding AddExpenseCurrency}" 
                                  Height="35"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,15" Visibility="{Binding IsAddCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Категорія" Style="{StaticResource ModalLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Categories}" 
                              SelectedItem="{Binding AddExpenseCategory}" 
                              Height="35"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Дата" Style="{StaticResource ModalLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding AddExpenseDate}" Height="35"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Опис" Style="{StaticResource ModalLabelStyle}"/>
                        <TextBox Text="{Binding AddExpenseDescription, UpdateSourceTrigger=PropertyChanged}" 
                             Height="80" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             VerticalContentAlignment="Top"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="Скасувати" 
                            Command="{Binding CancelAddExpenseCommand}" 
                            Width="190" Height="40" 
                            Background="#7994B2" Foreground="White" 
                            BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Додати" 
                            Command="{Binding SaveAddExpenseCommand}" 
                            Width="190" Height="40" 
                            Background="#4DB6AC" Foreground="White" 
                            BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="EditExpenseModalOverlay" 
          Grid.RowSpan="5"
          Visibility="{Binding IsEditExpenseModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
          Background="#CC000000" Panel.ZIndex="100">

            <Border Background="#2B2F3E" CornerRadius="10" Padding="30" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Редагувати запис" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <RadioButton Content="Витрата" IsChecked="{Binding IsEditExpense}" GroupName="EditTypeGroup" Foreground="White" FontSize="16" Margin="0,0,20,0"/>
                        <RadioButton Content="Дохід" IsChecked="{Binding IsEditIncome}" GroupName="EditTypeGroup" Foreground="White" FontSize="16"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Сума" Style="{StaticResource ModalLabelStyle}"/>
                            <TextBox Text="{Binding EditExpenseAmount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Валюта" Style="{StaticResource ModalLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Currencies}" 
                                  SelectedItem="{Binding EditExpenseCurrency}" 
                                  Height="35"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,15" Visibility="{Binding IsEditCategoryVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Категорія" Style="{StaticResource ModalLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Categories}" 
                              SelectedItem="{Binding EditExpenseCategory}" 
                              Height="35"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Дата" Style="{StaticResource ModalLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding EditExpenseDate}" Height="35"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,25">
                        <TextBlock Text="Опис" Style="{StaticResource ModalLabelStyle}"/>
                        <TextBox Text="{Binding EditExpenseDescription, UpdateSourceTrigger=PropertyChanged}" 
                             Height="80" 
                             TextWrapping="Wrap" 
                             AcceptsReturn="True" 
                             VerticalContentAlignment="Top"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Скасувати" 
                            Command="{Binding CancelEditExpenseCommand}" 
                            Width="190" Height="40" 
                            Background="#7994B2" Foreground="White" 
                            BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Зберегти зміни" 
                            Command="{Binding SaveEditExpenseCommand}" 
                            Width="190" Height="40" 
                            Background="#4DB6AC" Foreground="White" 
                            BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>