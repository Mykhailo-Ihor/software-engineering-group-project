<Window x:Class="TaskForge.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskForge.WPF"
        mc:Ignorable="d"
        Title="TaskForge" Height="700" Width="1100"
        Background="#222531"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#323645" Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/icon_.png" Width="30" Height="30" Margin="0,0,10,0"/>

                    <TextBlock Text="TaskForge" 
                               FontSize="20" 
                               FontWeight="Normal" 
                               VerticalAlignment="Center"
                               Foreground="White"/>
                </StackPanel>

                <StackPanel Grid.Column="2" 
                            Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Visibility="{Binding IsUserInfoVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                    <Button Command="{Binding ProfileCommand}" Style="{StaticResource HeaderButtonStyle}" ToolTip="Профіль">
                        <Ellipse Width="32" Height="32" Stroke="White" StrokeThickness="1">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding UserAvatar}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </Button>

                    <Button Command="{Binding LogoutCommand}" Style="{StaticResource HeaderButtonStyle}" ToolTip="Вийти">
                        <Path Data="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" 
                              Fill="White" 
                              Width="24" 
                              Height="24" 
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,20,0,0">

                <StackPanel x:Name="MainContentPanel" Visibility="{Binding IsMainContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                    <StackPanel Margin="50,0,50,20">
                        <TextBlock Text="Welcome back," FontSize="18" Foreground="White" Opacity="0.8"/>
                        <TextBlock Text="{Binding UserName}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Stretch" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="Створити проект"
                                    Height="40" Width="150" FontSize="14"
                                    Background="#2196F3" Foreground="White" BorderThickness="0"
                                    Command="{Binding CreateProjectCommand}" Margin="0,0,10,0">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="Мої проекти"
                                    Height="40" Width="180" FontSize="14"
                                    Background="#009688" Foreground="White" BorderThickness="0"
                                    Command="{Binding ViewProjectsCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>

                        <ListView x:Name="ProjectsListView"
                                  Margin="50,20,50,0"
                                  Visibility="{Binding IsProjectsListVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                  ItemsSource="{Binding Projects}"
                                  MaxHeight="400"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#2B2F3E" CornerRadius="8" Margin="0,0,0,10" Padding="15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <Button Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        HorizontalAlignment="Left" Padding="0"
                                                        Command="{Binding DataContext.OpenProjectDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding Id}">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="#64B5F6"/>
                                                </Button>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="#B0BEC5" Margin="0,5,0,5"/>
                                                <TextBlock FontSize="12" Foreground="#90A4AE">
                                                    <Run Text="Статус:" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding Status}" Foreground="#80CBC4"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <Separator Margin="50,20,50,20" Background="#404457"/>

                        <TextBlock Text="Швидкий доступ" FontSize="16" FontWeight="Bold" Margin="50,0,0,10"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                            <Button Content="Витрати" Height="40" Width="150" Margin="5"
                                    Background="#9C27B0" Foreground="White" BorderThickness="0"
                                    Command="{Binding ViewExpensesCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="Паролі" Height="40" Width="150" Margin="5"
                                    Background="#3F51B5" Foreground="White" BorderThickness="0"
                                    Command="{Binding OpenPasswordManagerCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Content="Підписки" Height="40" Width="150" Margin="5"
                                    Background="#3F51B5" Foreground="White" BorderThickness="0"
                                    Command="{Binding OpenSubscriptionManagerCommand}">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Grid x:Name="LoginPanel"
                      Visibility="{Binding IsLoginPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                      Margin="0,20,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1" 
                            Background="#2B2F3E" 
                            CornerRadius="15" 
                            Width="900" Height="500"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="5" Opacity="0.4"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" 
                                   Source="/Resources/welcome-screen-picture.png" 
                                   Stretch="Uniform" 
                                   Margin="40"/>

                            <StackPanel Grid.Column="1" 
                                        VerticalAlignment="Center" 
                                        Margin="0,0,60,0">

                                <TextBlock TextAlignment="Right" Margin="0,0,0,30">
                                    <Run Text="Ласкаво просимо до " FontSize="23" Foreground="White"/>
                                    <Run Text="TaskForge" FontSize="23" FontWeight="Bold" Foreground="#4DB6AC"/>
                                </TextBlock>

                                <TextBlock TextAlignment="Right" 
                                           TextWrapping="Wrap" 
                                           Foreground="#B0BEC5" 
                                           FontSize="14" 
                                           LineHeight="22"
                                           Margin="0,0,0,40">
                                    Керуйте своїми проектами ефективно та без зайвих зусиль. 
                                    Відстежуйте витрати, організовуйте завдання та співпрацюйте з командою в одному місці. 
                                    TaskForge надає інструменти, необхідні для досягнення успіху.
                                </TextBlock>

                                <TextBlock Text="Приєднуйтесь до нас вже зараз" 
                                           Foreground="White" 
                                           HorizontalAlignment="Right" 
                                           FontSize="14" 
                                           Margin="0,0,0,15"/>

                                <Button Content="Увійти"
                                        Command="{Binding LoginCommand}"
                                        IsEnabled="{Binding IsLoginButtonEnabled}"
                                        Width="200" Height="45"
                                        HorizontalAlignment="Right"
                                        FontSize="16" FontWeight="SemiBold"
                                        Background="#26A69A" 
                                        Foreground="White" 
                                        BorderThickness="0" 
                                        Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#546E7A"/>
                                                    <Setter Property="Foreground" Value="#B0BEC5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="StatusText"
                   Text="{Binding StatusText}"
                   HorizontalAlignment="Center"
                   Margin="10"
                   Foreground="Gray"/>

        <Grid x:Name="ProjectModalOverlay" 
            Grid.RowSpan="3"
            Visibility="{Binding IsProjectModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
            Background="#CC000000" 
            Panel.ZIndex="100">
            <Border Background="#323645" 
                CornerRadius="10" 
                Padding="30" 
                Width="400" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Створити проект" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="White"/>

                    <TextBlock Text="Назва проекту:" Margin="0,0,0,5" Foreground="#B0BEC5"/>
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" Margin="0,0,0,15"/>
                    <TextBlock Text="Статус проекту:" Margin="0,0,0,5" Foreground="#B0BEC5"/>
                    <TextBox Text="{Binding ProjectStatus, UpdateSourceTrigger=PropertyChanged}" Height="30" Padding="5" Margin="0,0,0,15"/>

                    <TextBlock Text="Опис проекту:" Margin="0,0,0,5" Foreground="#B0BEC5"/>
                    <TextBox Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}" Height="80" Padding="5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="OK" Width="80" Height="35" Margin="0,0,10,0" Command="{Binding SaveProjectCommand}" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="Скасувати" Width="80" Height="35" Command="{Binding CancelProjectCommand}" Background="#9E9E9E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>