<Window x:Class="TaskForge.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskForge.WPF"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        xmlns:components="clr-namespace:TaskForge.WPF.Components"
        mc:Ignorable="d"
        Title="TaskForge" Height="700" Width="1100"
        Background="#222531"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#455A64"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}" 
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="5" 
                        Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <components:AppHeader Grid.Row="0" Margin="0,0,0,-2"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,20,0,0">

                <StackPanel x:Name="MainContentPanel" Visibility="{Binding IsMainContentVisible, Converter={StaticResource BoolToVisibilityConverter}}">

                    <StackPanel Margin="50,0,50,20">
                        <TextBlock Text="З поверненням," FontSize="18" Foreground="White" Opacity="0.8"/>
                        <TextBlock Text="{Binding UserName}" FontSize="24" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>

                    <Grid Margin="50,0,50,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#2B2F3E" CornerRadius="10" Padding="25" Height="320">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Фінансовий звіт" Foreground="White" FontSize="18" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <ItemsControl VerticalAlignment="Center" Grid.Column="0" ItemsSource="{Binding RecentExpenses}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Description}" Foreground="#E0E0E0" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Expense">
                                                                        <Setter Property="Foreground" Value="#EF5350"/>
                                                                        <Setter Property="Text" Value="{Binding Amount, StringFormat='-{0:N0} UAH'}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Type}" Value="Income">
                                                                        <Setter Property="Foreground" Value="#66BB6A"/>
                                                                        <Setter Property="Text" Value="{Binding Amount, StringFormat='+{0:N0} UAH'}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <lvc:PieChart Grid.Column="2" 
                              Series="{Binding DashboardPieChartSeries}" 
                              LegendLocation="None" 
                              InnerRadius="0"
                              HoverPushOut="3"
                              Margin="10,0">
                                        <lvc:PieChart.DataTooltip>
                                            <lvc:DefaultTooltip SelectionMode="OnlySender" Background="#323645" Foreground="White"/>
                                        </lvc:PieChart.DataTooltip>
                                    </lvc:PieChart>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="Переглянути більше" Command="{Binding ViewExpensesCommand}" Height="40" Background="#7994B2" Foreground="White" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Grid.Column="2" Content="Додати запис" Command="{Binding ViewExpensesCommand}" Height="40" Background="#26A69A" Foreground="White" BorderThickness="0" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#2B2F3E" CornerRadius="10" Padding="25" Height="320">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Підписки" 
                       Foreground="White" 
                       FontSize="18" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentSubscriptions}" VerticalAlignment="Top">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#3C4050" BorderThickness="0,0,0,1" Margin="0,0,0,12" Padding="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="60"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" 
                                           Text="{Binding Name}" 
                                           Foreground="#E0E0E0" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,10,0"/>

                                                    <TextBlock Grid.Column="1" 
                                           FontSize="14" 
                                           FontWeight="SemiBold" 
                                           Foreground="#EF5350" 
                                           VerticalAlignment="Center"
                                           Margin="0,0,20,0">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="-{0:N0} {1}">
                                                                <Binding Path="Amount"/>
                                                                <Binding Path="Currency"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>

                                                    <TextBlock Grid.Column="2" 
                                           Text="{Binding BillingDate, StringFormat='{}{0:dd/MM}'}" 
                                           Foreground="White" 
                                           FontSize="14" 
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Right"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="1" 
                       Text="Немає активних підписок" 
                       Foreground="#607D8B" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RecentSubscriptions.Count}" Value="0">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <Grid Grid.Row="2" Margin="0,15,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" 
                        Content="Переглянути більше" 
                        Command="{Binding OpenSubscriptionManagerCommand}"
                        Height="40"
                        Background="#7994B2" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Grid.Column="2" 
                        Content="Додати запис" 
                        Command="{Binding OpenSubscriptionManagerCommand}" 
                        Height="40"
                        Background="#26A69A" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Margin="50,0,50,50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#2B2F3E" CornerRadius="10" Padding="25" Height="360">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Проекти" 
                       Foreground="White" 
                       FontSize="18" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentProjects}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2" Rows="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>

                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Command="{Binding DataContext.OpenProjectDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                 CommandParameter="{Binding Id}"
                                                 Height="80"
                                                 Margin="6"
                                                 Background="#3C4050"
                                                 BorderThickness="0"
                                                 Cursor="Hand">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="15,10">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Name}" 
                                                                       Foreground="White" 
                                                                       FontSize="15" 
                                                                       FontWeight="SemiBold"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Margin="0,0,0,3"/>

                                                                    <TextBlock FontSize="11" Foreground="#B0BEC5">
                                                                        <Run Text="{Binding Status}"/>
                                                                        <Run Text="•"/>
                                                                        <Run Text="{Binding UserRoleInProject}"/>
                                                                    </TextBlock>
                                                                </StackPanel>

                                                                <Path Grid.Column="1" 
                                                  Data="M0,0 L4,4 L0,8" 
                                                  Stroke="#B0BEC5" 
                                                  StrokeThickness="1.5" 
                                                  VerticalAlignment="Center" 
                                                  Margin="10,0,0,0"/>
                                                            </Grid>

                                                            <VisualStateManager.VisualStateGroups>
                                                                <VisualStateGroup x:Name="CommonStates">
                                                                    <VisualState x:Name="Normal"/>
                                                                    <VisualState x:Name="MouseOver">
                                                                        <Storyboard>
                                                                            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                        To="#454955" Duration="0:0:0.1"/>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                    <VisualState x:Name="Pressed">
                                                                        <Storyboard>
                                                                            <ColorAnimation Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                                        To="#323645" Duration="0:0:0.1"/>
                                                                        </Storyboard>
                                                                    </VisualState>
                                                                </VisualStateGroup>
                                                            </VisualStateManager.VisualStateGroups>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="1" 
                       Text="У вас поки немає проектів" 
                       Foreground="#607D8B" 
                       FontSize="14"
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       Visibility="{Binding RecentProjects.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}"/>

                                <Grid Grid.Row="2" Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" 
                        Content="Переглянути більше" 
                        Command="{Binding ViewProjectsCommand}"
                        Height="40"
                        Background="#7994B2" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Grid.Column="2" 
                        Content="Додати проект" 
                        Command="{Binding CreateProjectCommand}" 
                        Height="40"
                        Background="#26A69A" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                        <Border Grid.Column="2" Background="#2B2F3E" CornerRadius="10" Padding="25" Height="360">
                            <Border.Effect>
                                <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="5" Opacity="0.3"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Паролі" 
                       Foreground="White" 
                       FontSize="18" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,20"/>

                                <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentPasswords}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#3C4050" BorderThickness="0,0,0,1" Margin="0,0,0,12" >
                                                <Grid Margin="0,0,0,15">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" 
                                       Text="{Binding Password.Note}" 
                                       Foreground="#E0E0E0" 
                                       FontSize="14" 
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0,0,10,0"/>

                                                    <Button Grid.Column="1" 
                                    Content="Копіювати" 
                                    Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Password.PasswordEncrypted}"
                                    Width="80" Height="30"
                                    Background="#7994B2" 
                                    Foreground="White" 
                                    FontSize="12"
                                    BorderThickness="0" 
                                    Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="5"/>
                                                            </Style>
                                                        </Button.Resources>
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="5" >
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Opacity" Value="0.9"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Grid.Row="1" 
                       Text="Немає збережених паролів" 
                       Foreground="#607D8B" 
                       VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       Visibility="{Binding RecentPasswords.Count, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}"/>

                                <Grid Grid.Row="2" Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="20"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" 
                        Content="Переглянути більше" 
                        Command="{Binding OpenPasswordManagerCommand}"
                        Height="40"
                        Background="#7994B2" 
                        Foreground="White" 
                        BorderThickness="0" 
                        Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button Grid.Column="2" 
                                            Content="Додати пароль" 
                                            Command="{Binding OpenAddPasswordModalCommand}" 
                                            Height="40"
                                            Background="#26A69A" 
                                            Foreground="White" 
                                            BorderThickness="0" 
                                            Cursor="Hand">
                                    
                                    <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="0.9"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>

                    </Grid>
                </StackPanel>

                <Grid x:Name="LoginPanel"
                      Visibility="{Binding IsLoginPanelVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                      Margin="0,20,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="1" 
                            Background="#2B2F3E" 
                            CornerRadius="15" 
                            Width="900" Height="500"
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="5" Opacity="0.4"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Grid.Column="0" 
                                   Source="/Resources/welcome-screen-picture.png" 
                                   Stretch="Uniform" 
                                   Margin="40"/>

                            <StackPanel Grid.Column="1" 
                                        VerticalAlignment="Center" 
                                        Margin="0,0,60,0">

                                <TextBlock TextAlignment="Right" Margin="0,0,0,30">
                                    <Run Text="Ласкаво просимо до " FontSize="23" Foreground="White"/>
                                    <Run Text="TaskForge" FontSize="23" FontWeight="Bold" Foreground="#4DB6AC"/>
                                </TextBlock>

                                <TextBlock TextAlignment="Right" 
                                           TextWrapping="Wrap" 
                                           Foreground="#B0BEC5" 
                                           FontSize="14" 
                                           LineHeight="22"
                                           Margin="0,0,0,40">
                                    Керуйте своїми проектами ефективно та без зайвих зусиль. 
                                    Відстежуйте витрати, організовуйте завдання та співпрацюйте з командою в одному місці. 
                                    TaskForge надає інструменти, необхідні для досягнення успіху.
                                </TextBlock>

                                <TextBlock Text="Приєднуйтесь до нас вже зараз" 
                                           Foreground="White" 
                                           HorizontalAlignment="Right" 
                                           FontSize="14" 
                                           Margin="0,0,0,15"/>

                                <Button Content="Увійти"
                                        Command="{Binding LoginCommand}"
                                        IsEnabled="{Binding IsLoginButtonEnabled}"
                                        Width="200" Height="45"
                                        HorizontalAlignment="Right"
                                        FontSize="16" FontWeight="SemiBold"
                                        Background="#26A69A" 
                                        Foreground="White" 
                                        BorderThickness="0" 
                                        Cursor="Hand">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="5"/>
                                        </Style>
                                    </Button.Resources>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Opacity" Value="0.9"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter Property="Background" Value="#546E7A"/>
                                                    <Setter Property="Foreground" Value="#B0BEC5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="StatusText"
                   Text="{Binding StatusText}"
                   HorizontalAlignment="Center"
                   Margin="10"
                   Foreground="Gray"/>

        <Grid x:Name="ProjectModalOverlay" 
            Grid.RowSpan="3"
            Visibility="{Binding IsProjectModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
            Background="#CC000000" 
            Panel.ZIndex="100">
            <Border Background="#323645" 
                CornerRadius="10" 
                Padding="30" 
                Width="450" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Створити проект" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center" Foreground="White"/>

                    <TextBlock Text="Назва проекту:" Margin="0,0,0,5" Foreground="#B0BEC5"/>
                    <TextBox Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>
                    <TextBlock Text="Статус проекту:" Margin="0,0,0,5" Foreground="#B0BEC5"/>
                    <TextBox Text="{Binding ProjectStatus, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                    <TextBlock Text="Опис проекту:" Margin="0,0,0,5" Foreground="#B0BEC5"/>
                    <TextBox Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}" Height="80" Padding="5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button 
                            Content="Скасувати" 
                            Width="190" 
                            Height="40" 
                            Command="{Binding CancelProjectCommand}" 
                            Background="#7994B2" 
                            Foreground="White" 
                            Margin="0,0,10,0" 
                            BorderThickness="0" 
                            Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button 
                            Content="Додати" 
                            Width="190" 
                            Height="40" 
                            Command="{Binding SaveProjectCommand}" 
                            Background="#4DB6AC" 
                            Foreground="White" 
                            BorderThickness="0" 
                            Cursor="Hand">                      
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="AddPasswordModalOverlay" 
              Grid.RowSpan="3"
              Visibility="{Binding IsAddPasswordModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
              Background="#CC000000" 
              Panel.ZIndex="101">
            <Border Background="#323645" 
                    CornerRadius="10" 
                    Padding="30" 
                    Width="450" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Додати пароль" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="URL" Style="{StaticResource ModalLabelStyle}"/>
                    <TextBox Text="{Binding AddPasswordUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                    <TextBlock Text="Логін" Style="{StaticResource ModalLabelStyle}"/>
                    <TextBox Text="{Binding AddPasswordLogin, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                    <TextBlock Text="Пароль" Style="{StaticResource ModalLabelStyle}"/>
                    <PasswordBox x:Name="NewPasswordBox" 
                                 Height="35" 
                                 Background="#455A64" 
                                 Foreground="White" 
                                 BorderThickness="0"
                                 Padding="5"
                                 Margin="0,0,0,15">
                        <PasswordBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>

                    <TextBlock Text="Категорія" Style="{StaticResource ModalLabelStyle}"/>
                    <ComboBox ItemsSource="{Binding PasswordCategories}" 
                      SelectedItem="{Binding AddPasswordCategory}"
                      Height="35"
                      Margin="0,0,0,15"/>

                    <TextBlock Text="Нотатки" Style="{StaticResource ModalLabelStyle}"/>
                    <TextBox Text="{Binding AddPasswordNote, UpdateSourceTrigger=PropertyChanged}" 
                     Height="60" 
                     TextWrapping="Wrap" 
                     AcceptsReturn="True" 
                     VerticalContentAlignment="Top" 
                     Margin="0,0,0,20"/>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Content="Скасувати" 
                                Height="35" 
                                Command="{Binding CancelAddPasswordCommand}" 
                                Style="{StaticResource ActionButtonStyle}" 
                                Background="#78909C" Foreground="White" BorderThickness="0"/>

                        <Button Grid.Column="2" 
                                Content="Зберегти" 
                                Height="35" 
                                Command="{Binding SaveAddPasswordCommand}" 
                                Style="{StaticResource ActionButtonStyle}" 
                                Background="#26A69A" Foreground="White" BorderThickness="0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>