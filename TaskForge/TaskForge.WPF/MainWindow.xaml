<Window x:Class="TaskForge.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskForge.WPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Content="Login" Click="LoginButton_Click" Width="200" Margin="10"/>
            <Button Content="Logout" Click="LogoutButton_Click" Width="200" Margin="10"/>
            <Button Content="Show Profile" Click="ShowProfileButton_Click" Width="200" Margin="10"/>
            <TextBlock x:Name="UserProfileText" Text="User Profile" Margin="10"/>
        </StackPanel>
    </Grid>
</Window>
