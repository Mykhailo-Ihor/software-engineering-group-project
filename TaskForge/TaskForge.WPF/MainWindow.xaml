<Window x:Class="TaskForge.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskForge.WPF"
        mc:Ignorable="d"
        Title="TaskForge" Height="600" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="TaskForge" 
                   FontSize="24" 
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,20"/>

        <!-- Контент (центральна частина) -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Інформація про користувача -->
                <StackPanel x:Name="UserInfoPanel"
                            Visibility="Collapsed"
                            Margin="50,0,50,0">
                    <Border Background="#E8F5E9" 
                            BorderBrush="#4CAF50" 
                            BorderThickness="2" 
                            CornerRadius="5" 
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="Ви увійшли!" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="#2E7D32"
                                       Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Ім'я: " FontWeight="Bold" Width="80"/>
                                <TextBlock x:Name="UserNameText"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="Email: " FontWeight="Bold" Width="80"/>
                                <TextBlock x:Name="UserEmailText"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,5">
                                <TextBlock Text="User ID: " FontWeight="Bold" Width="80"/>
                                <TextBlock x:Name="UserIdText" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel HorizontalAlignment="Stretch" Margin="0,20,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button x:Name="CreateProjectButton"
                                    Content="Створити проект"
                                    Height="40"
                                    Width="150"
                                    FontSize="14"
                                    Background="#2196F3"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="CreateProjectButton_Click"
                                    Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        BorderThickness="0">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#1976D2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button x:Name="ViewProjectsButton"
                                    Content="Переглянути мої проекти"
                                    Height="40"
                                    Width="180"
                                    FontSize="14"
                                    Background="#009688"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="ViewProjectsButton_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="5"
                                                        BorderThickness="0">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#00796B"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        
                        <ListView x:Name="ProjectsListView"
                                  Margin="0,15,0,0"
                                  Visibility="Collapsed"
                                  MaxHeight="400"
                                  BorderThickness="0"
                                  Background="GhostWhite"
                                  HorizontalContentAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="Gainsboro" BorderThickness="0,0,0,1" Padding="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                                <Button Background="Transparent" 
                                                    BorderThickness="0" 
                                                    Cursor="Hand"
                                                    HorizontalAlignment="Left"
                                                    Padding="0"
                                                    Click="ProjectName_Click"
                                                    Tag="{Binding Id}">
                                                    <TextBlock Text="{Binding Name}" 
                                                       FontWeight="Bold" 
                                                       FontSize="16" 
                                                       Foreground="#2196F3"
                                                       TextDecorations="Underline"/>                
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Opacity" Value="0.7"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="Gray" Margin="0,5,0,5"/>
                                                <TextBlock FontSize="12">
                                                    <Run Text="Статус:" FontWeight="SemiBold"/>
                                                    <Run Text="{Binding Status}" Foreground="DarkCyan"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <!--тут була кнопка для додати завдання-->
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </StackPanel>

                <!-- Екран логіну -->
                <StackPanel x:Name="LoginPanel"
                            VerticalAlignment="Center"
                            Margin="50">
                    <TextBlock Text="Увійдіть за допомогою Auth0" 
                               FontSize="16" 
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Натисніть кнопку нижче для входу або реєстрації" 
                               HorizontalAlignment="Center"
                               Foreground="Gray"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,10"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки внизу -->
        <StackPanel Grid.Row="2" Margin="50,20,50,20">
            <Button x:Name="LoginButton"
                    Content="Увійти / Зареєструватися"
                    Height="45"
                    FontSize="16"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="LoginButton_Click"/>

            <Button x:Name="LogoutButton"
                    Content="Вийти"
                    Height="40"
                    FontSize="14"
                    Background="#F44336"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="LogoutButton_Click"
                    Visibility="Collapsed"
                    Margin="0,10,0,0"/>

            <TextBlock x:Name="StatusText"
                       Text=""
                       HorizontalAlignment="Center"
                       Margin="0,10,0,0"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       TextAlignment="Center"/>
        </StackPanel>

        <!-- Модальні вікна -->
        <Grid x:Name="ProjectModalOverlay" 
              Grid.RowSpan="3"
              Visibility="Collapsed" 
              Background="#80000000" 
              Panel.ZIndex="100">
            <Border Background="White" 
                    CornerRadius="10" 
                    Padding="30" 
                    Width="400" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Створити проект" FontSize="20" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
                    <TextBlock Text="Назва проекту:" Margin="0,0,0,5"/>
                    <TextBox x:Name="ProjectNameBox" Height="30" Padding="5" Margin="0,0,0,15"/>
                    <TextBlock Text="Статус проекту:" Margin="0,0,0,5"/>
                    <TextBox x:Name="ProjectStatusBox" Height="30" Padding="5" Text="Active" Margin="0,0,0,15"/>
                    <TextBlock Text="Опис проекту:" Margin="0,0,0,5"/>
                    <TextBox x:Name="ProjectDescriptionBox" Height="80" Padding="5" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,20"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="OK" Width="80" Height="35" Margin="0,0,10,0" Click="ProjectModalOk_Click" Background="#4CAF50" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="Скасувати" Width="80" Height="35" Click="ProjectModalCancel_Click" Background="#9E9E9E" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        
        <!--тут були модалки-->
    </Grid>
</Window>