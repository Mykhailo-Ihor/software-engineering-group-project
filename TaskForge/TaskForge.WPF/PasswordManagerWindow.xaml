<Window x:Class="TaskForge.WPF.PasswordManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        mc:Ignorable="d"
        Title="Password Manager" Height="700" Width="1100"
        Background="#222531"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid Margin="40,30,40,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Your passwords" FontSize="28" Foreground="White" VerticalAlignment="Center"/>
                
                <Button Grid.Column="1" Content="Filter" Background="Transparent" Foreground="#90A4AE" BorderThickness="0" 
                        FontSize="16" Margin="0,0,20,0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <TextBlock Text="{TemplateBinding Content}" Foreground="#90A4AE" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <Path Data="M0,0 L3,3 L6,0" Stroke="#B0BEC5" StrokeThickness="1" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Grid.Column="2" Content="Add password" 
                        Command="{Binding OpenAddCommand}"
                        Width="120" Height="40"
                        Background="#4DB6AC" 
                        Foreground="White"
                        FontSize="14"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Passwords}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DashboardCardStyle}" Height="160" Margin="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Style="{StaticResource CategoryTagStyle}" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Password.Category}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                                    </Border>

                                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                        <Border Padding="20,10,20,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayTitle}" FontSize="16" FontWeight="Bold" Foreground="White" 
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                                                <TextBlock Text="{Binding Password.Login}" FontSize="14" Foreground="#B0BEC5" 
                                                           TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>
                                                <Separator Margin="0,0,0,10" Background="#333" Height="1"/>
                                                <TextBlock Text="{Binding DisplayedPassword}" FontSize="15" Foreground="#90A4AE" 
                                                           FontFamily="Consolas" TextTrimming="CharacterEllipsis" Margin="0,0,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource ActionIconButtonStyle}" 
                                                Command="{Binding DataContext.ToggleVisibilityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Show/Hide Password">
                                            <Path Data="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z" 
                                                  Fill="#B0BEC5" Stretch="Uniform" Width="16" Height="16"/>
                                        </Button>

                                        <Button Style="{StaticResource ActionIconButtonStyle}" 
                                                Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding DecryptedPassword}"
                                                ToolTip="Copy Password"
                                                Margin="5,0,0,0">
                                            <Path Data="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z" 
                                                  Fill="#B0BEC5" Stretch="Uniform" Width="16" Height="16"/>
                                        </Button>

                                        <Button Style="{StaticResource ActionIconButtonStyle}" 
                                                Command="{Binding DataContext.OpenEditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Edit"
                                                Margin="5,0,0,0">
                                            <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" 
                                                  Fill="#B0BEC5" Stretch="Uniform" Width="16" Height="16"/>
                                        </Button>

                                        <Button Style="{StaticResource ActionIconButtonStyle}" 
                                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Password.Id}"
                                                ToolTip="Delete"
                                                Margin="5,0,0,0">
                                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" 
                                                  Fill="#B0BEC5" Stretch="Uniform" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Grid Visibility="{Binding IsAddModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
              Background="#CC000000" Panel.ZIndex="100">
            <Border Background="#2B2F3E" CornerRadius="10" Padding="30" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Додати пароль" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="URL" Style="{StaticResource ModalLabelStyle}"/>
                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Логін" Style="{StaticResource ModalLabelStyle}"/>
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Пароль" Style="{StaticResource ModalLabelStyle}"/>
                    <PasswordBox x:Name="AddPasswordBox" Height="35" Background="#455A64" Foreground="White" BorderThickness="0">
                        <PasswordBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>

                    <TextBlock Text="Категорія" Style="{StaticResource ModalLabelStyle}" Margin="0,15,0,5"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>

                    <TextBlock Text="Нотатки" Style="{StaticResource ModalLabelStyle}" Margin="0,15,0,5"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" 
                             AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Скасувати" Command="{Binding CancelCommand}" Width="100" Height="40" 
                                Background="#78909C" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Зберегти" Command="{Binding SaveAddCommand}" Width="100" Height="40" 
                                Background="#26A69A" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsEditModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
              Background="#CC000000" Panel.ZIndex="100">
            <Border Background="#2B2F3E" CornerRadius="10" Padding="30" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Редагувати пароль" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="URL" Style="{StaticResource ModalLabelStyle}"/>
                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Логін" Style="{StaticResource ModalLabelStyle}"/>
                    <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="Пароль" Style="{StaticResource ModalLabelStyle}"/>
                    <PasswordBox x:Name="EditPasswordBox" Height="35" Background="#455A64" Foreground="White" BorderThickness="0">
                        <PasswordBox.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="5"/>
                            </Style>
                        </PasswordBox.Resources>
                    </PasswordBox>

                    <TextBlock Text="Категорія" Style="{StaticResource ModalLabelStyle}" Margin="0,15,0,5"/>
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}"/>

                    <TextBlock Text="Нотатки" Style="{StaticResource ModalLabelStyle}" Margin="0,15,0,5"/>
                    <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Height="80" TextWrapping="Wrap" 
                             AcceptsReturn="True" VerticalContentAlignment="Top" Margin="0,0,0,20"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Скасувати" Command="{Binding CancelEditCommand}" Width="100" Height="40" 
                                Background="#78909C" Foreground="White" BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="Зберегти зміни" Command="{Binding SaveEditCommand}" Width="120" Height="40" 
                                Background="#26A69A" Foreground="White" BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>