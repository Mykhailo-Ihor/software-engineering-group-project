<Window x:Class="TaskForge.WPF.PasswordManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:TaskForge.WPF.Converters"
        Title="Password Manager" Height="600" Width="800">
    <Window.Resources>
        <conv:BooleanToShowHideConverter x:Key="BooleanToShowHideConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Password Manager" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,20,0,20"/>

        <!-- Password List -->
        <ListView x:Name="PasswordListView" Grid.Row="1" Margin="20" 
        ItemsSource="{Binding Passwords}" 
         SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Password.Id}" Width="50"/>
                    <GridViewColumn Header="URL" DisplayMemberBinding="{Binding Password.Url}" Width="200"/>
                    <GridViewColumn Header="Login" DisplayMemberBinding="{Binding Password.Login}" Width="200"/>
                    <GridViewColumn Header="Password" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Width="100" VerticalAlignment="Center"
              Text="{Binding DisplayedPassword}"/>
                                    <Button Content="Copy" Width="50" Height="25" Margin="5,0,0,0"
   Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=ListView}}" 
   CommandParameter="{Binding Password.PasswordEncrypted}"/>
                                    <Button Content="{Binding IsRevealed, Converter={StaticResource BooleanToShowHideConverter}}" Width="50" Height="25" Margin="5,0,0,0"
           Command="{Binding DataContext.ToggleVisibilityCommand, RelativeSource={RelativeSource AncestorType=ListView}}" 
              CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Note" DisplayMemberBinding="{Binding Password.Note}" Width="200"/>
                    <GridViewColumn Header="Category" DisplayMemberBinding="{Binding Password.Category}" Width="100"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,20">
            <Button Content="Add Password" Width="120" Margin="10" Command="{Binding OpenAddCommand}"/>
            <Button Content="Edit Password" Width="120" Margin="10" Command="{Binding OpenEditCommand}" CommandParameter="{Binding SelectedItem}"/>
            <Button Content="Delete Password" Width="120" Margin="10" Command="{Binding DeleteCommand}" CommandParameter="{Binding SelectedItem.Password.Id}"/>
        </StackPanel>

        <!-- Add Password Modal -->
        <Grid x:Name="AddPasswordModalOverlay" Grid.RowSpan="3" 
        Visibility="{Binding IsAddModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
 Background="#80000000" Panel.ZIndex="100">
            <Border Background="White" CornerRadius="10" Padding="30" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Add Password" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <StackPanel>
                        <TextBlock Text="URL" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,10"/>

                        <TextBlock Text="Login" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,10"/>

                        <TextBlock Text="Password" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PasswordText, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,10"/>

                        <TextBlock Text="Note" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,10"/>

                        <TextBlock Text="Category" Foreground="Gray" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Categories}" 
    SelectedItem="{Binding SelectedCategory}" 
  Margin="0,10,0,10"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Width="80" Margin="10,0,0,0" Command="{Binding CancelCommand}"/>
                        <Button Content="Save" Width="80" Command="{Binding SaveAddCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Edit Password Modal -->
        <Grid x:Name="EditPasswordModalOverlay" Grid.RowSpan="3" 
 Visibility="{Binding IsEditModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
      Background="#80000000" Panel.ZIndex="100">
            <Border Background="White" CornerRadius="10" Padding="30" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Edit Password" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

                    <StackPanel>
                        <TextBlock Text="URL" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,10"/>

                        <TextBlock Text="Login" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,10"/>

                        <TextBlock Text="Password" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding PasswordText, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,10"/>

                        <TextBlock Text="Note" Foreground="Gray" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,10"/>

                        <TextBlock Text="Category" Foreground="Gray" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Categories}" 
        SelectedItem="{Binding SelectedCategory}" 
          Margin="0,10,0,10"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Width="80" Margin="10,0,0,0" Command="{Binding CancelEditCommand}"/>
                        <Button Content="Save" Width="80" Command="{Binding SaveEditCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>