<Window x:Class="TaskForge.WPF.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="Profile" Height="520" Width="400">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Border Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="2" CornerRadius="10" Padding="20" Margin="20">
            <StackPanel HorizontalAlignment="Center">
                <Ellipse Width="96" Height="96" Stroke="#4CAF50" StrokeThickness="2">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="{Binding ProfileAvatar}" />
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="First Name:" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Left" FontWeight="Bold"/>
                <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsFieldsEnabled}"
                         FontSize="16" Margin="0,0,0,0" HorizontalAlignment="Left" Width="250"/>
                <TextBlock Text="Last Name:" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Left" FontWeight="Bold"/>
                <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsFieldsEnabled}"
                         FontSize="16" Margin="0,0,0,0" HorizontalAlignment="Left" Width="250"/>
                <TextBlock Text="Email:" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Left" FontWeight="Bold"/>
                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                         IsEnabled="{Binding IsFieldsEnabled}"
                         FontSize="16" Margin="0,0,0,0" HorizontalAlignment="Left" Width="250"/>
                <TextBlock Text="{Binding ProfileInfoText}" 
                           FontSize="14" Foreground="DarkRed" Margin="0,10,0,0" 
                           Visibility="{Binding ProfileInfoVisibility}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Content="Save" Width="100" Height="35" Margin="0,0,10,0" 
                            Command="{Binding SaveCommand}" 
                            Visibility="{Binding SaveButtonVisibility}"
                            Background="#2196F3" Foreground="White" BorderThickness="0"/>
                    <Button Content="Close" Width="100" Height="35" 
                            Command="{Binding CloseCommand}"
                            Background="#4CAF50" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
