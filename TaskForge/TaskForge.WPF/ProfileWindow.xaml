<Window x:Class="TaskForge.WPF.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:local="clr-namespace:TaskForge.WPF"
        xmlns:components="clr-namespace:TaskForge.WPF.Components"
        mc:Ignorable="d"
        Title="Your Profile" Height="1080" Width="1920"
        Background="#222531"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="InputLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#B0BEC5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="#D9D9D9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="#222"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <components:AppHeader Grid.Row="0" Margin="0,0,0,-2"/>

        <Grid Grid.Row="1" Margin="40">
            <Border Background="#2B2F3E" CornerRadius="10" Padding="40">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>

                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <Ellipse Width="200" Height="200">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.2"/>
                            </Ellipse.Effect>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding ProfileAvatar}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                    </StackPanel>

                    <StackPanel Grid.Column="2" 
                    Width="450" 
                    VerticalAlignment="Center">

                        <TextBlock Text="Ваш профіль" FontSize="32" Foreground="White" Margin="0,0,0,30"/>

                        <TextBlock Text="Ім'я" Style="{StaticResource InputLabel}"/>
                        <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" 
                     IsEnabled="{Binding IsFieldsEnabled}"/>

                        <TextBlock Text="Прізвище" Style="{StaticResource InputLabel}"/>
                        <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" 
                     IsEnabled="{Binding IsFieldsEnabled}"/>

                        <TextBlock Text="Email" Style="{StaticResource InputLabel}"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" 
                     IsEnabled="{Binding IsFieldsEnabled}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Content="Скасувати" Height="50"
                        Command="{Binding CloseCommand}"
                        Background="#78909C" Foreground="White" 
                        BorderThickness="0" FontSize="16" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>

                            <Button Grid.Column="2" Content="Зберегти" Height="50"
                        Command="{Binding SaveCommand}"
                        Visibility="{Binding SaveButtonVisibility}"
                        Background="#26A69A" Foreground="White" 
                        BorderThickness="0" FontSize="16" Cursor="Hand">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="5"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </Grid>

                        <TextBlock Text="{Binding ProfileInfoText}" 
                       Foreground="#EF5350" Margin="0,15,0,0" 
                       Visibility="{Binding ProfileInfoVisibility}" 
                       HorizontalAlignment="Center"/>

                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>