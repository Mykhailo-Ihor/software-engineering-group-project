<Window x:Class="TaskForge.WPF.ProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Profile" Height="520" Width="400">
    <Grid>
        <Border Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="2" CornerRadius="10" Padding="20" Margin="20">
            <StackPanel HorizontalAlignment="Center">
                <Ellipse Width="96" Height="96" Stroke="#4CAF50" StrokeThickness="2">
                    <Ellipse.Fill>
                        <ImageBrush x:Name="ProfileAvatarBrush" ImageSource="pack://application:,,,/TaskForge.WPF;component/Resources/avatar_placeholder.png" />
                    </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="First Name:" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Left" FontWeight="Bold"/>
                <TextBox x:Name="FirstNameBox" FontSize="16" Margin="0,0,0,0" HorizontalAlignment="Left" Width="250"/>
                <TextBlock Text="Last Name:" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Left" FontWeight="Bold"/>
                <TextBox x:Name="LastNameBox" FontSize="16" Margin="0,0,0,0" HorizontalAlignment="Left" Width="250"/>
                <TextBlock Text="Email:" FontSize="16" Margin="0,10,0,0" HorizontalAlignment="Left" FontWeight="Bold"/>
                <TextBox x:Name="EmailBox" FontSize="16" Margin="0,0,0,0" HorizontalAlignment="Left" Width="250"/>
                <TextBlock x:Name="ProfileInfoText" FontSize="14" Foreground="DarkRed" Margin="0,10,0,0" Visibility="Collapsed"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button x:Name="SaveButton" Content="Save" Width="100" Height="35" Margin="0,0,10,0" Click="SaveButton_Click" Background="#2196F3" Foreground="White" BorderThickness="0"/>
                    <Button Content="Close" Width="100" Height="35" Click="CloseButton_Click" Background="#4CAF50" Foreground="White" BorderThickness="0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
