<Window x:Class="TaskForge.WPF.ProjectDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="Деталі проекту"
        Height="600"
Width="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}"/>
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20">
            <StackPanel>
                <TextBlock Text="{Binding ProjectName}" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="White"/>
                <TextBlock Text="{Binding ProjectDescription}" 
                           FontSize="14" 
                           Foreground="White" 
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ProjectStatus}" 
                           FontSize="12" 
                           Foreground="White" 
                           Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Додати користувача до проекту"
                            Width="220"
                            Height="30"
                            Margin="0,10,0,0"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding AddUserToProjectCommand}"/>

                    <Button Content="Призначити модератора"
                            Width="180"
                            Height="30"
                            Margin="10,10,0,0"
                            Background="#7439bd"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding ManageModeratorsCommand}"
                            Visibility="{Binding IsManageModeratorsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button Content="Вигнати учасника"
                            Width="180"
                            Height="30"
                            Margin="10,10,0,0"
                            Background="#C62828" 
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding OpenKickUserModalCommand}"
                            Visibility="{Binding IsManageModeratorsVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>    

                    <Button Content="Редагувати проєкт"
                            Width="180"
                            Height="30"
                            Margin="10,10,0,0"
                            Background="#8e39bd"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding EditProjectCommand}"
                            Visibility="{Binding IsEditProjectVisible, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Button Content="Покинути проєкт"
                            Width="180"
                            Height="30"
                            Margin="10,10,0,0"
                            Background="#E53935"
                            Foreground="White"
                            BorderThickness="0"
                            Command="{Binding LeaveProjectCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>



        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Canvas Height="64" Width="760">
                    <TextBlock
      FontWeight="Bold" FontSize="18" Text="Завдання проекту" HorizontalAlignment="Center" Canvas.Top="18" VerticalAlignment="Top"/>

                    <Button
     Content="Створити завдання"
           Background="Gray"
     Foreground="White"
                Height="30"
   Width="120"
            FontSize="12"
  BorderThickness="0"
                Command="{Binding AddTaskCommand}"
         Canvas.Left="612" Canvas.Top="17">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}"
    CornerRadius="5"
      BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center"
    VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#00796B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="340,17,0,5">
                        <Label Content="" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Width="4">
                            <Label.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="-1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Label.RenderTransform>
                        </Label>
                        <ComboBox Width="203" Margin="5,0" 
               ItemsSource="{Binding UserFilterItems}"
         SelectedItem="{Binding SelectedUserFilter}"
       DisplayMemberPath="Username" 
     SelectedValuePath="Id" 
      RenderTransformOrigin="0.509,0.566" Height="30"/>
                        <Button
             Content="Скинути"
                Background="Gray"
            Foreground="White"
                 Height="30"
          Width="52"
         FontSize="12"
   BorderThickness="0"
          Command="{Binding ClearFilterCommand}">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}"
       CornerRadius="5"
           BorderThickness="0">
                                                    <ContentPresenter HorizontalAlignment="Center"
 VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#00796B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Canvas>

                <ListView ItemsSource="{Binding Tasks}" Height="300" BorderThickness="1" BorderBrush="LightGray">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" BorderThickness="0,0,0,1" BorderBrush="LightGray">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding Title}"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="Gray"/>
                                        <TextBlock Margin="0,5,0,0">
                <Run FontWeight="SemiBold" Text="Термін:"/>
     <Run Text=" "/>
          <Run Text="{Binding DueDate, StringFormat=\{0:dd.MM.yyyy\}}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center" Margin="10,0" Grid.Column="1">
                                        <TextBlock Text="Виконавці:" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold" Foreground="#2196F3"/>
                                        <ItemsControl ItemsSource="{Binding TaskUsers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,4" Margin="0,2" CornerRadius="3" Background="#E3F2FD">
                                                        <TextBlock FontSize="11">
  <Run Text="{Binding User.FirstName}"/>
         <Run Text=" "/>
         <Run Text="{Binding User.LastName}"/>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Button Grid.Column="2"
     Content="Редагувати"
           Command="{Binding DataContext.EditTaskCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
   CommandParameter="{Binding Id}"
   VerticalAlignment="Center"
         Background="#FFC107"
              Foreground="White"
       BorderThickness="0"
     Padding="10,5"
  Margin="0,0,5,0"/>

                                    <Button Grid.Column="3"
         Content="Видалити"
         Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
            CommandParameter="{Binding Id}"
             VerticalAlignment="Center"
       Background="#F44336"
         Foreground="White"
 BorderThickness="0"
   Padding="10,5"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button
       Width="100" 
      Margin="0,20,0,0" 
   Height="35" 
 Foreground="White" 
               Content="Закрити" 
        Command="{Binding CloseCommand}"
     BorderThickness="0" 
  Background="#F44336"/>
            </StackPanel>
        </ScrollViewer>

        <!--Modal windows-->
        <Grid Visibility="{Binding IsTaskModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
              Grid.RowSpan="3"
        Background="#80000000" 
              Panel.ZIndex="101">
            <Border Background="White" CornerRadius="10" Padding="20" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Створити нове завдання" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="Проект:" Margin="0,0,0,5"/>
                    <ComboBox ItemsSource="{Binding UserProjects}" 
                              SelectedValue="{Binding SelectedProjectId}"
                              Margin="0,0,0,10" 
                              DisplayMemberPath="Name" 
                              SelectedValuePath="Id"/>
                    <TextBlock Text="Назва завдання:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding TaskTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <TextBlock Text="Опис:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding TaskDescription, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>
                    <TextBlock Text="Термін виконання:" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding TaskDueDate}" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding SelectedAssigneesText}" Margin="0,0,0,5" Foreground="Gray"/>
                    <Button Content="Призначити виконавців" 
                             Command="{Binding AssignUsersCommand}"
                             Margin="0,0,0,20"
                             Width="360" Height="35"
                             Background="#2196F3"
                             Foreground="White"
                             BorderThickness="0"/> 
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Створити" Width="80" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Command="{Binding SaveTaskCommand}"/>
                        <Button Content="Скасувати" Width="80" Height="35" Margin="0,0,10,0" Background="Gray" Foreground="White" BorderThickness="0" Command="{Binding CancelTaskCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsEditProjectModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
              Grid.RowSpan="3"
              Background="#80000000" 
              Panel.ZIndex="202">
            <Border Background="White" CornerRadius="10" Padding="20" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Налаштування проєкту" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Назва проєкту:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="30" Padding="5"/>

                    <TextBlock Text="Опис проєкту:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditProjectDescription, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="5"/>

                    <TextBlock Text="Статус проєкту:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditProjectStatus, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,20" Height="30" Padding="5"/>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" 
                                    Content="Зберегти" 
                                    Height="35" 
                                    Margin="0,0,5,0" 
                                    Background="#4CAF50" 
                                    Foreground="White" 
                                    BorderThickness="0" 
                                    Command="{Binding SaveEditProjectCommand}"/>

                            <Button Grid.Column="1" 
                                    Content="Скасувати" 
                                    Height="35" 
                                    Margin="5,0,0,0" 
                                    Background="Gray" 
                                    Foreground="White" 
                                    BorderThickness="0" 
                                    Command="{Binding CancelEditProjectCommand}"/>
                        </Grid>

                        <Button Grid.Row="1" 
                                Content="Видалити проект"
                                Height="35"
                                Background="#D32F2F" 
                                Foreground="White" 
                                BorderThickness="0"
                                Command="{Binding DeleteProjectCommand}"
                                HorizontalAlignment="Stretch"
                                Margin="0,15,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsAssignUsersModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
         Grid.RowSpan="3"
      Background="#99000000" 
    Panel.ZIndex="102">
            <Border Background="White" CornerRadius="10" Padding="20" Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Вибрати виконавців" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <ListBox ItemsSource="{Binding UsersForAssignment}" Height="200" Margin="0,0,0,15">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding FullName}" IsChecked="{Binding IsSelected}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Зберегти" Width="100" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Command="{Binding SaveAssignUsersCommand}"/>
                        <Button Content="Скасувати" Width="100" Height="35" Margin="0,0,10,0" Background="Gray" Foreground="White" BorderThickness="0" Command="{Binding CancelAssignUsersCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsLeaveProjectModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
              Grid.RowSpan="2"
              Background="#80000000" 
              Panel.ZIndex="203" HorizontalAlignment="Left" Width="800">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48*"/>
                <ColumnDefinition Width="39*"/>
                <ColumnDefinition Width="313*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" CornerRadius="10" Padding="20" Width="400" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="2" Margin="26,0,0,0">
                <StackPanel>
                    <TextBlock Text="Передача прав модератора" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Ви - останній модератор. Щоб покинути проект, виберіть хоча б одного користувача, якому будуть передані права модератора:" TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <ListView ItemsSource="{Binding UsersToPromote}" MaxHeight="300">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding FullName}" IsChecked="{Binding IsSelected}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Зберегти і вийти" Width="140" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Command="{Binding SaveAndLeaveProjectCommand}"/>
                        <Button Content="Скасувати" Width="100" Height="35" Margin="0,0,10,0" Background="Gray" Foreground="White" BorderThickness="0" Command="{Binding CancelLeaveProjectCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Edit Task Modal -->
        <Grid Visibility="{Binding IsEditTaskModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
              Grid.RowSpan="3"
              Background="#80000000"
              Panel.ZIndex="103">
            <Border Background="White" CornerRadius="10" Padding="20" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Редагувати завдання" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="Назва завдання:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditTaskTitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>
                    <TextBlock Text="Опис:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding EditTaskDescription, UpdateSourceTrigger=PropertyChanged}" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>
                    <TextBlock Text="Термін виконання:" Margin="0,0,0,5"/>
                    <DatePicker SelectedDate="{Binding EditTaskDueDate}" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Зберегти" Width="80" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Command="{Binding SaveEditTaskCommand}"/>
                        <Button Content="Скасувати" Width="80" Height="35" Margin="0,0,10,0" Background="Gray" Foreground="White" BorderThickness="0" Command="{Binding CancelEditTaskCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Add modal for adding user by email -->
        <Grid Visibility="{Binding IsAddUserModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
  Grid.RowSpan="3"
     Background="#80000000" 
    Panel.ZIndex="200">
            <Border Background="White" CornerRadius="10" Padding="20" Width="350" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Додати користувача до проекту" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Email користувача:" Margin="0,0,0,5"/>
                    <TextBox Text="{Binding AddUserEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Додати" Width="80" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Command="{Binding SaveAddUserCommand}"/>
                        <Button Content="Скасувати" Width="80" Height="35" Margin="0,0,10,0" Background="Gray" Foreground="White" BorderThickness="0" Command="{Binding CancelAddUserCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Modal for managing moderators -->
        <Grid Visibility="{Binding IsManageModeratorsModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
                Grid.RowSpan="2"
                Background="#80000000" 
                Panel.ZIndex="201">
            <Border Background="White" CornerRadius="10" Padding="20" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Керування модераторами" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Відмітьте користувачів, які мають бути модераторами:" Margin="0,0,0,10"/>
                    <ListView ItemsSource="{Binding Moderators}" MaxHeight="300">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding FullName}" IsChecked="{Binding IsModerator}" IsEnabled="{Binding CanChange}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Зберегти" Width="80" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Command="{Binding SaveModeratorsCommand}"/>
                        <Button Content="Скасувати" Width="80" Height="35" Margin="0,0,10,0" Background="Gray" Foreground="White" BorderThickness="0" Command="{Binding CancelModeratorsCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Visibility="{Binding IsKickUserModalVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
      Grid.RowSpan="2"
      Background="#80000000" 
      Panel.ZIndex="205">
            <Border Background="White" CornerRadius="10" Padding="20" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Вигнати учасника з проекту" FontSize="18" FontWeight="Bold" Margin="0,0,0,5" Foreground="#C62828"/>
                    <TextBlock Text="Оберіть користувача для видалення:" Margin="0,0,0,15" Foreground="Gray"/>

                    <ListView ItemsSource="{Binding UsersToKickList}" MaxHeight="300" BorderThickness="1" BorderBrush="#EEEEEE">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="5" BorderThickness="0,0,0,1" BorderBrush="#EEEEEE">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding FirstName}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding LastName}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Email}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                        Content="Вигнати"
                                        Background="#E53935"
                                        Foreground="White"
                                        BorderThickness="0"
                                        FontSize="12"
                                        Padding="10,5"
                                        Margin="10,0,0,0"
                                        Command="{Binding DataContext.KickUserCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Id}">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="4">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#B71C1C"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Закрити" Width="100" Height="35" Background="Gray" Foreground="White" BorderThickness="0" Command="{Binding CloseKickUserModalCommand}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>