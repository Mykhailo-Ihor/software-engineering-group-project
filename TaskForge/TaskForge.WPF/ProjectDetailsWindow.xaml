<Window x:Class="TaskForge.WPF.ProjectDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Деталі проекту"
        Height="600"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#2196F3" Padding="20">
            <StackPanel>
                <TextBlock x:Name="ProjectNameText" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           Foreground="White"/>
                <TextBlock x:Name="ProjectDescriptionText" 
                           FontSize="14" 
                           Foreground="White" 
                           Margin="0,5,0,0"
                           TextWrapping="Wrap"/>
                <TextBlock x:Name="ProjectStatusText" 
                           FontSize="12" 
                           Foreground="White" 
                           Margin="0,5,0,0"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="AddUserToProjectButton"
                            Content="Додати користувача до проекту"
                            Width="220"
                            Height="30"
                            Margin="0,10,0,0"
                            Background="#4CAF50"
                            Foreground="White"
                            BorderThickness="0"
                            Click="AddUserToProjectButton_Click"/>

                    <Button x:Name="ManageModeratorsButton"
                            Content="Призначити модератора"
                            Width="180"
                            Height="30"
                            Margin="10,10,0,0"
                            Background="#FF9800"
                            Foreground="White"
                            BorderThickness="0"
                            Click="ManageModeratorsButton_Click"
                            Visibility="Collapsed"/>

                    <Button x:Name="EditProjectButton"
                            Content="Редагувати проєкт"
                            Width="180"
                            Height="30"
                            Margin="10,10,0,0"
                            Background="#f44336"
                            Foreground="White"
                            BorderThickness="0"
                            Click="EditProjectButton_Click"
                            Visibility="Collapsed"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Контент -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20">
                <Canvas Height="64" Width="760">
                    <TextBlock
                        FontWeight="Bold" FontSize="18" Text="Завдання проекту" HorizontalAlignment="Center" Canvas.Top="18" VerticalAlignment="Top"/>

                    <Button
                        Content="Створити завдання"
                        Background="Gray"
                        Foreground="White"
                        Height="30"
                        Width="120"
                        FontSize="12"
                        BorderThickness="0"
                        Click="AddTaskButton_Click"
                        Tag="{Binding Id}" Canvas.Left="612" Canvas.Top="17">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Button}">
                                            <Border Background="{TemplateBinding Background}"
                                                CornerRadius="5"
                                                BorderThickness="0">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#00796B"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="340,17,0,5">
                        <Label Content="" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Width="4">
                            <Label.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform ScaleX="-1"/>
                                    <SkewTransform/>
                                    <RotateTransform/>
                                    <TranslateTransform/>
                                </TransformGroup>
                            </Label.RenderTransform>
                        </Label>
                        <ComboBox x:Name="UserFilterComboBox" Width="203" Margin="5,0" SelectionChanged="UserFilterComboBox_SelectionChanged" DisplayMemberPath="Username" SelectedValuePath="Id" RenderTransformOrigin="0.509,0.566" Height="30"/>
                        <Button
    Content="Скинути"
    Background="Gray"
    Foreground="White"
    Height="30"
    Width="52"
    FontSize="12"
    BorderThickness="0"
    Click="ClearFilterButton_Click"
    Tag="{Binding Id}" Canvas.Left="612" Canvas.Top="17">
                            <Button.Style>
                                <Style TargetType="{x:Type Button}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type Button}">
                                                <Border Background="{TemplateBinding Background}"
                            CornerRadius="5"
                            BorderThickness="0">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#00796B"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>

                </Canvas>
                <ListView
                    x:Name="TasksListView" Height="300" BorderThickness="1" BorderBrush="LightGray">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10" BorderThickness="0,0,0,1" BorderBrush="LightGray">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock FontWeight="Bold" FontSize="14" Text="{Binding Title}"/>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,5,0,0" Foreground="Gray"/>
                                        <TextBlock Margin="0,5,0,0">
                                            <Run FontWeight="SemiBold" Text="Термін:"/>
                                            <Run Text=" "/>
                                            <Run Text="{Binding DueDate, StringFormat=\{0:dd.MM.yyyy\}}"/>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel VerticalAlignment="Center" Margin="10,0" Grid.Column="1">
                                        <TextBlock Text="Виконавці:" Margin="0,0,0,5" FontSize="12" FontWeight="SemiBold" Foreground="#2196F3"/>
                                        <ItemsControl ItemsSource="{Binding TaskUsers}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="8,4" Margin="0,2" CornerRadius="3" Background="#E3F2FD">
                                                        <TextBlock FontSize="11">
                                                            <Run Text="{Binding User.FirstName}"/>
                                                            <Run Text=" "/>
                                                            <Run Text="{Binding User.LastName}"/>
                                                        </TextBlock>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <Button Grid.Column="2"
                                            Content="Редагувати"
                                            Tag="{Binding Id}"
                                            Click="EditTaskButton_Click"
                                            VerticalAlignment="Center"
                                            Background="#FFC107"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="10,5"
                                            Margin="0,0,5,0"/>

                                    <Button Grid.Column="3"
                                            Content="Видалити"
                                            Tag="{Binding Id}"
                                            Click="DeleteTaskButton_Click"
                                            VerticalAlignment="Center"
                                            Background="#F44336"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Padding="10,5"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button
                    Width="100" 
                    Margin="0,20,0,0" 
                    Height="35" 
                    Foreground="White" 
                    Content="Закрити" 
                    Click="CloseButton_Click" 
                    BorderThickness="0" 
                    Background="#F44336"/>
            </StackPanel>
        </ScrollViewer>

        <!--Modal windows-->
        <Grid x:Name="TaskModalOverlay" 
          Grid.RowSpan="3"
          Visibility="Collapsed" 
          Background="#80000000" 
          Panel.ZIndex="101">
            <Border Background="White" CornerRadius="10" Padding="20" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Створити нове завдання" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="Проект:" Margin="0,0,0,5"/>
                    <ComboBox x:Name="TaskProjectComboBox" Margin="0,0,0,10" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                    <TextBlock Text="Назва завдання:" Margin="0,0,0,5"/>
                    <TextBox x:Name="TaskTitleBox" Margin="0,0,0,10"/>
                    <TextBlock Text="Опис:" Margin="0,0,0,5"/>
                    <TextBox x:Name="TaskDescriptionBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>
                    <TextBlock Text="Термін виконання:" Margin="0,0,0,5"/>
                    <DatePicker x:Name="TaskDueDateBox" Margin="0,0,0,15"/>
                    <TextBlock x:Name="SelectedAssigneesText" Text="Виконавці: не обрано" Margin="0,0,0,5" Foreground="Gray"/>
                    <Button Content="Призначити виконавців" 
                    Click="AssignUsersButton_Click" 
                    Margin="0,0,0,20"
                    Width="360" Height="35"
                    Background="#2196F3"
                    Foreground="White"
                    BorderThickness="0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Створити" Width="80" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="TaskModalOk_Click"/>
                        <Button Content="Скасувати" Width="80" Height="35" Margin="0,0,10,0" Background="Gray" Foreground="White" BorderThickness="0" Click="TaskModalCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="EditProjectModalOverlay" 
              Grid.RowSpan="3"
              Visibility="Collapsed" 
              Background="#80000000" 
              Panel.ZIndex="202">
            <Border Background="White" CornerRadius="10" Padding="20" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Налаштування проєкту" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>

                    <TextBlock Text="Назва проєкту:" Margin="0,0,0,5"/>
                    <TextBox x:Name="EditProjectNameBox" Margin="0,0,0,10" Height="30" Padding="5"/>

                    <TextBlock Text="Опис проєкту:" Margin="0,0,0,5"/>
                    <TextBox x:Name="EditProjectDescriptionBox" Margin="0,0,0,10" Height="80" TextWrapping="Wrap" AcceptsReturn="True" Padding="5"/>

                    <TextBlock Text="Статус проєкту:" Margin="0,0,0,5"/>
                    <TextBox x:Name="EditProjectStatusBox" Margin="0,0,0,20" Height="30" Padding="5"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Зберегти" Width="80" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="EditProjectSave_Click"/>
                        <Button Content="Скасувати" Width="80" Height="35" Margin="0,0,10,0" Background="Gray" Foreground="White" BorderThickness="0" Click="EditProjectCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="AssignUsersModalOverlay" 
          Grid.RowSpan="3"
          Visibility="Collapsed" 
          Background="#99000000" 
          Panel.ZIndex="102">
            <Border Background="White" CornerRadius="10" Padding="20" Width="300" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Вибрати виконавців" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <ListBox x:Name="UsersForAssignmentListBox" Height="200" Margin="0,0,0,15">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding FullName}" Tag="{Binding Id}" IsChecked="{Binding IsSelected}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Зберегти" Width="100" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="AssignUsersSave_Click"/>
                        <Button Content="Скасувати" Width="100" Height="35" Margin="0,0,10,0" Background="Gray" Foreground="White" BorderThickness="0" Click="AssignUsersCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Edit Task Modal -->
        <Grid x:Name="EditTaskModalOverlay"
              Grid.RowSpan="3"
              Visibility="Collapsed"
              Background="#80000000"
              Panel.ZIndex="103">
            <Border Background="White" CornerRadius="10" Padding="20" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Редагувати завдання" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>
                    <TextBlock Text="Назва завдання:" Margin="0,0,0,5"/>
                    <TextBox x:Name="EditTaskTitleBox" Margin="0,0,0,10"/>
                    <TextBlock Text="Опис:" Margin="0,0,0,5"/>
                    <TextBox x:Name="EditTaskDescriptionBox" Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10"/>
                    <TextBlock Text="Термін виконання:" Margin="0,0,0,5"/>
                    <DatePicker x:Name="EditTaskDueDateBox" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Зберегти" Width="80" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="EditTaskModalOk_Click"/>
                        <Button Content="Скасувати" Width="80" Height="35" Margin="0,0,10,0" Background="Gray" Foreground="White" BorderThickness="0" Click="EditTaskModalCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Add modal for adding user by email -->
        <Grid x:Name="AddUserModalOverlay" 
          Grid.RowSpan="3"
          Visibility="Collapsed" 
          Background="#80000000" 
          Panel.ZIndex="200">
            <Border Background="White" CornerRadius="10" Padding="20" Width="350" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Додати користувача до проекту" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Email користувача:" Margin="0,0,0,5"/>
                    <TextBox x:Name="AddUserEmailBox" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Додати" Width="80" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="AddUserModalOk_Click"/>
                        <Button Content="Скасувати" Width="80" Height="35" Margin="0,0,10,0" Background="Gray" Foreground="White" BorderThickness="0" Click="AddUserModalCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <!-- Modal for managing moderators -->
        <Grid x:Name="ManageModeratorsModalOverlay" 
              Grid.RowSpan="2"
              Visibility="Collapsed" 
              Background="#80000000" 
              Panel.ZIndex="201">
            <Border Background="White" CornerRadius="10" Padding="20" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="Керування модераторами" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <TextBlock Text="Відмітьте користувачів, які мають бути модераторами:" Margin="0,0,0,10"/>
                    <ListView x:Name="ModeratorsListView" MaxHeight="300">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding FullName}" IsChecked="{Binding IsModerator}" IsEnabled="{Binding CanChange}"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Зберегти" Width="80" Height="35" Margin="0,0,10,0" Background="#4CAF50" Foreground="White" BorderThickness="0" Click="ManageModeratorsSave_Click"/>
                        <Button Content="Скасувати" Width="80" Height="35" Margin="0,0,10,0" Background="Gray" Foreground="White" BorderThickness="0" Click="ManageModeratorsCancel_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>