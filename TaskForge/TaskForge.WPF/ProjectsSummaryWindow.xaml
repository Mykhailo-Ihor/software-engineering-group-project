<Window x:Class="TaskForge.WPF.ProjectsSummaryWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TaskForge.WPF.ViewModels"
        xmlns:converters="clr-namespace:TaskForge.WPF.Converters"
        mc:Ignorable="d"
        Title="TaskForge - Projects" 
        Height="800" Width="1200"
        MinHeight="600" MinWidth="900"
       WindowStartupLocation="CenterScreen"
        Background="#222531"
        Loaded="Window_Loaded">
  
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:InitialsConverter x:Key="InitialsConverter"/>
        <converters:AvatarColorConverter x:Key="AvatarColorConverter"/>
        
        <Style x:Key="HeaderButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="10,0,0,0"/>
    <Setter Property="Template">
 <Setter.Value>
         <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
       </ControlTemplate>
  </Setter.Value>
     </Setter>
            <Style.Triggers>
         <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Opacity" Value="0.7"/>
     </Trigger>
</Style.Triggers>
   </Style>
   
      <Style x:Key="ProjectCardIconButtonStyle" TargetType="Button">
       <Setter Property="Background" Value="Transparent"/>
       <Setter Property="BorderThickness" Value="0"/>
  <Setter Property="Cursor" Value="Hand"/>
       <Setter Property="Width" Value="28"/>
       <Setter Property="Height" Value="28"/>
       <Setter Property="Opacity" Value="0.6"/>
 <Setter Property="Template">
 <Setter.Value>
 <ControlTemplate TargetType="Button">
      <Border Background="{TemplateBinding Background}" CornerRadius="4">
        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
   </Border>
     <ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True">
      <Setter Property="Opacity" Value="1"/>
       </Trigger>
     </ControlTemplate.Triggers>
       </ControlTemplate>
    </Setter.Value>
     </Setter>
        </Style>
        
 <!-- Avatar Style for Participants -->
        <Style x:Key="ParticipantAvatarStyle" TargetType="Border">
    <Setter Property="Width" Value="30"/>
  <Setter Property="Height" Value="30"/>
   <Setter Property="CornerRadius" Value="15"/>
   <Setter Property="Margin" Value="-8,0,0,0"/>
  <Setter Property="BorderBrush" Value="#323645"/>
 <Setter Property="BorderThickness" Value="2"/>
  </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
      <RowDefinition Height="60"/>
    <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

   <!-- Header -->
    <Border Grid.Row="0" Background="#323645" Padding="20,0">
    <Grid>
     <Grid.ColumnDefinitions>
       <ColumnDefinition Width="Auto"/>
    <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>

       <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
<Image Source="/Resources/icon_.png" Width="30" Height="30" Margin="0,0,10,0"/>
          <TextBlock Text="TaskForge" 
         FontSize="20" 
      FontWeight="Normal" 
 VerticalAlignment="Center"
   Foreground="White"/>
      </StackPanel>

     <StackPanel Grid.Column="2" 
     Orientation="Horizontal" 
 VerticalAlignment="Center">
          
      <Button Command="{Binding ProfileCommand}" 
         Style="{StaticResource HeaderButtonStyle}" 
   ToolTip="Profile">
  <Ellipse Width="32" Height="32" Stroke="White" StrokeThickness="1">
       <Ellipse.Fill>
          <ImageBrush ImageSource="{Binding UserAvatar}" Stretch="UniformToFill"/>
  </Ellipse.Fill>
      </Ellipse>
      </Button>

   <Button Command="{Binding LogoutCommand}" 
    Style="{StaticResource HeaderButtonStyle}" 
  ToolTip="Logout">
        <Path Data="M10.09 15.59L11.5 17l5-5-5-5-1.41 1.41L12.67 11H3v2h9.67l-2.58 2.59zM19 3H5c-1.11 0-2 .9-2 2v4h2V5h14v14H5v-4H3v4c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2z" 
   Fill="White" 
   Width="24" 
        Height="24" 
    Stretch="Uniform"/>
  </Button>
 </StackPanel>
   </Grid>
      </Border>

    <!-- Main Content -->
        <Grid Grid.Row="1" Margin="40,20,40,30">
    <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
   <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

            <!-- Header Row with Title and Controls -->
  <Grid Grid.Row="0" Margin="0,0,0,30">
       <Grid.ColumnDefinitions>
  <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>

        <!-- Title -->
      <TextBlock Grid.Column="0" 
        Text="Your projects" 
   FontSize="32" 
     FontWeight="SemiBold"
   Foreground="White" 
       VerticalAlignment="Center"/>

     <!-- Controls -->
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       
            <!-- Search TextBox (visible when IsSearchVisible is true) -->
        <Border Background="#3C4050" 
       CornerRadius="5" 
          Padding="10,0"
       Margin="0,0,15,0"
       Visibility="{Binding IsSearchVisible, Converter={StaticResource BoolToVisibilityConverter}}">
 <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
<TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
         Width="200"
 Background="Transparent"
     Foreground="White"
 BorderThickness="0"
     VerticalAlignment="Center"
   FontSize="14"
  CaretBrush="White">
     <TextBox.Style>
        <Style TargetType="TextBox">
     <Setter Property="Template">
     <Setter.Value>
         <ControlTemplate TargetType="TextBox">
 <ScrollViewer x:Name="PART_ContentHost" 
       VerticalAlignment="Center"/>
       </ControlTemplate>
     </Setter.Value>
         </Setter>
       </Style>
       </TextBox.Style>
   </TextBox>
         <!-- Clear Search Button -->
  <Button Command="{Binding ClearSearchCommand}"
   Background="Transparent"
  BorderThickness="0"
    Cursor="Hand"
       Margin="5,0,0,0"
           ToolTip="Clear search"
 Visibility="{Binding SearchText.Length, Converter={StaticResource BoolToVisibilityConverter}}">
  <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
Fill="#9E9E9E" 
  Width="12" Height="12"
      Stretch="Uniform"/>
         </Button>
     </StackPanel>
  </Border>
            
    <!-- Filter Button -->
   <Button Command="{Binding ToggleSearchCommand}"
   Background="Transparent"
             BorderThickness="0"
 Cursor="Hand"
       Margin="0,0,20,0">
       <Button.Style>
  <Style TargetType="Button">
 <Setter Property="Opacity" Value="0.7"/>
        <Style.Triggers>
   <Trigger Property="IsMouseOver" Value="True">
  <Setter Property="Opacity" Value="1"/>
  </Trigger>
   <DataTrigger Binding="{Binding IsSearchVisible}" Value="True">
     <Setter Property="Opacity" Value="1"/>
       </DataTrigger>
 </Style.Triggers>
     </Style>
 </Button.Style>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Path Data="M4,4 L20,4 L14,12 L14,18 L10,20 L10,12 Z" 
    Stroke="#B0BEC5" 
      StrokeThickness="1.5"
        Fill="Transparent"
      Width="16" Height="16"
       Stretch="Uniform"
      VerticalAlignment="Center"/>
   <TextBlock Text="Filter" 
  Foreground="#B0BEC5" 
      FontSize="14" 
        Margin="8,0,0,0"
       VerticalAlignment="Center"/>
       </StackPanel>
 </Button>

     <!-- Add Project Button -->
    <Button Command="{Binding AddProjectCommand}"
       Width="140" Height="42"
      Background="#26A69A" 
      Foreground="White"
    FontSize="14"
        FontWeight="Medium"
         BorderThickness="0"
    Cursor="Hand">
<Button.Resources>
        <Style TargetType="Border">
  <Setter Property="CornerRadius" Value="5"/>
      </Style>
      </Button.Resources>
       <StackPanel Orientation="Horizontal">
         <TextBlock Text="+" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
     <TextBlock Text="Add project" VerticalAlignment="Center"/>
</StackPanel>
   </Button>
    </StackPanel>
 </Grid>

         <!-- Projects Grid -->
       <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <ItemsControl ItemsSource="{Binding Projects}">
       <ItemsControl.ItemsPanel>
      <ItemsPanelTemplate>
     <UniformGrid Columns="3"/>
    </ItemsPanelTemplate>
         </ItemsControl.ItemsPanel>

<ItemsControl.ItemTemplate>
        <DataTemplate>
    <Border Background="#323645" 
        CornerRadius="8" 
    Padding="20" 
  Margin="10" 
  Height="180"
 Cursor="Hand">
   <Border.Effect>
         <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="0" Opacity="0.3"/>
            </Border.Effect>
       <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick" 
     Command="{Binding DataContext.OpenProjectDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
   CommandParameter="{Binding Id}"/>
       </Border.InputBindings>
      
            <Grid>
    <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
  <RowDefinition Height="*"/>
         <RowDefinition Height="Auto"/>
     </Grid.RowDefinitions>

 <!-- Top Row: Project Name + Action Buttons -->
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="Auto"/>
    </Grid.ColumnDefinitions>

 <!-- Project Name -->
      <TextBlock Grid.Column="0"
 Text="{Binding Name}" 
    FontSize="20" 
  FontWeight="SemiBold"
     Foreground="White"
    TextTrimming="CharacterEllipsis"
   TextWrapping="NoWrap"
    VerticalAlignment="Center"
     ToolTip="{Binding Name}"/>

        <!-- Action Buttons -->
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
       <!-- Edit Button -->
        <Button Style="{StaticResource ProjectCardIconButtonStyle}"
      Command="{Binding DataContext.EditProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
      CommandParameter="{Binding Id}"
     ToolTip="Edit project"
     Margin="0,0,4,0">
  <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" 
    Fill="#9E9E9E" Stretch="Uniform" Width="14" Height="14"/>
           </Button>

        <!-- Leave Button -->
        <Button Style="{StaticResource ProjectCardIconButtonStyle}"
  Command="{Binding DataContext.LeaveProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
         CommandParameter="{Binding Id}"
   ToolTip="Leave project"
    Margin="0,0,4,0">
    <Path Data="M10 9V5L3 12l7 7v-4.1c5 0 8.5 1.6 11 5.1-1-5-4-10-11-11z" 
 Fill="#9E9E9E" Stretch="Uniform" Width="14" Height="14"
     RenderTransformOrigin="0.5,0.5">
   <Path.RenderTransform>
<ScaleTransform ScaleX="-1"/>
       </Path.RenderTransform>
        </Path>
 </Button>

   <!-- Delete Button -->
   <Button Style="{StaticResource ProjectCardIconButtonStyle}"
    Command="{Binding DataContext.DeleteProjectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
  CommandParameter="{Binding Id}"
           ToolTip="Delete project">
    <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" 
  Fill="#9E9E9E" Stretch="Uniform" Width="14" Height="14"/>
  </Button>
              </StackPanel>
   </Grid>

       <!-- Middle: Description (optional) -->
     <TextBlock Grid.Row="1"
Text="{Binding Description}"
     FontSize="13"
  Foreground="#9E9E9E"
           TextTrimming="CharacterEllipsis"
    TextWrapping="Wrap"
         MaxHeight="40"
   Margin="0,10,0,0"
 VerticalAlignment="Top"/>

 <!-- Bottom Row: Participants -->
      <StackPanel Grid.Row="2" Orientation="Vertical">
           <TextBlock Text="Participants:" 
    FontSize="12" 
   Foreground="#78909C"
    Margin="0,0,0,8"/>
   
       <!-- Real Participants with Overlapping Avatars -->
      <ItemsControl ItemsSource="{Binding Participants}" Margin="8,0,0,0">
        <ItemsControl.ItemsPanel>
  <ItemsPanelTemplate>
        <StackPanel Orientation="Horizontal"/>
     </ItemsPanelTemplate>
     </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
    <DataTemplate>
  <Border Width="30" Height="30" 
  CornerRadius="15"
      Margin="-8,0,0,0"
            BorderBrush="#323645"
   BorderThickness="2"
       Background="{Binding Id, Converter={StaticResource AvatarColorConverter}}"
          ToolTip="{Binding Email}">
        <TextBlock Text="{Binding Converter={StaticResource InitialsConverter}}"
    Foreground="White"
   FontSize="11"
      FontWeight="SemiBold"
       HorizontalAlignment="Center"
   VerticalAlignment="Center"/>
        </Border>
    </DataTemplate>
           </ItemsControl.ItemTemplate>
     </ItemsControl>
         
      <!-- Empty state for no participants -->
     <TextBlock Text="No participants" 
     FontSize="11" 
      Foreground="#546E7A"
            Margin="0,4,0,0">
        <TextBlock.Style>
   <Style TargetType="TextBlock">
 <Setter Property="Visibility" Value="Collapsed"/>
       <Style.Triggers>
  <DataTrigger Binding="{Binding Participants.Count}" Value="0">
   <Setter Property="Visibility" Value="Visible"/>
  </DataTrigger>
         </Style.Triggers>
  </Style>
    </TextBlock.Style>
   </TextBlock>
     </StackPanel>
  </Grid>
      </Border>
  </DataTemplate>
         </ItemsControl.ItemTemplate>
   </ItemsControl>
  </ScrollViewer>

          <!-- Empty State -->
      <StackPanel Grid.Row="1" 
        HorizontalAlignment="Center" 
    VerticalAlignment="Center">
   <StackPanel.Style>
        <Style TargetType="StackPanel">
        <Setter Property="Visibility" Value="Collapsed"/>
    <Style.Triggers>
          <DataTrigger Binding="{Binding Projects.Count}" Value="0">
               <Setter Property="Visibility" Value="Visible"/>
    </DataTrigger>
 </Style.Triggers>
  </Style>
     </StackPanel.Style>
      <TextBlock Text="No projects yet" 
  FontSize="24" 
         Foreground="#78909C" 
  HorizontalAlignment="Center"
       Margin="0,0,0,10"/>
      <TextBlock Text="Click 'Add project' to create your first project" 
  FontSize="14" 
  Foreground="#546E7A" 
              HorizontalAlignment="Center"/>
            </StackPanel>
     </Grid>

        <!-- Add Project Modal - Must be last and span all rows -->
     <Grid x:Name="AddProjectModalOverlay" 
       Grid.Row="0"
      Grid.RowSpan="2"
          Visibility="{Binding IsAddProjectModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
       Background="#CC000000" 
     Panel.ZIndex="1000">
   <Border Background="#2B2F3E" CornerRadius="10" Padding="30" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
       <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
     </Border.Effect>

 <StackPanel>
    <TextBlock Text="Add New Project" 
          FontSize="24" 
       FontWeight="Bold" 
      Foreground="White" 
       Margin="0,0,0,25" 
          HorizontalAlignment="Center"/>

   <TextBlock Text="Project Name" Style="{StaticResource ModalLabelStyle}"/>
         <TextBox Text="{Binding AddProjectName, UpdateSourceTrigger=PropertyChanged}" 
      Margin="0,0,0,15"/>

    <TextBlock Text="Description (optional)" Style="{StaticResource ModalLabelStyle}"/>
        <TextBox Text="{Binding AddProjectDescription, UpdateSourceTrigger=PropertyChanged}" 
        Height="80"
      TextWrapping="Wrap"
   AcceptsReturn="True"
   VerticalScrollBarVisibility="Auto"
       Margin="0,0,0,20"/>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" 
       Command="{Binding CancelAddProjectCommand}" 
     Width="100" Height="40" 
        Background="#546E7A" Foreground="White" 
       BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
    <Button.Resources>
   <Style TargetType="Border">
   <Setter Property="CornerRadius" Value="5"/>
        </Style>
   </Button.Resources>
 </Button>

  <Button Content="Create" 
     Command="{Binding SaveAddProjectCommand}" 
      Width="100" Height="40" 
   Background="#26A69A" Foreground="White" 
      BorderThickness="0" Cursor="Hand">
  <Button.Resources>
     <Style TargetType="Border">
      <Setter Property="CornerRadius" Value="5"/>
   </Style>
       </Button.Resources>
         </Button>
           </StackPanel>
    </StackPanel>
     </Border>
        </Grid>

        <!-- Edit Project Modal - Must be last and span all rows -->
        <Grid x:Name="EditProjectModalOverlay" 
  Grid.Row="0"
  Grid.RowSpan="2"
        Visibility="{Binding IsEditProjectModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
   Background="#CC000000" 
  Panel.ZIndex="1001">
    <Border Background="#2B2F3E" CornerRadius="10" Padding="30" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center">
 <Border.Effect>
    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>

           <StackPanel>
     <TextBlock Text="Edit Project" 
        FontSize="24" 
     FontWeight="Bold" 
    Foreground="White" 
   Margin="0,0,0,25" 
  HorizontalAlignment="Center"/>

      <TextBlock Text="Project Name" Style="{StaticResource ModalLabelStyle}"/>
 <TextBox Text="{Binding EditProjectName, UpdateSourceTrigger=PropertyChanged}" 
         Margin="0,0,0,15"/>

  <TextBlock Text="Description (optional)" Style="{StaticResource ModalLabelStyle}"/>
           <TextBox Text="{Binding EditProjectDescription, UpdateSourceTrigger=PropertyChanged}" 
      Height="80"
    TextWrapping="Wrap"
     AcceptsReturn="True"
      VerticalScrollBarVisibility="Auto"
       Margin="0,0,0,20"/>

   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
       <Button Content="Cancel" 
    Command="{Binding CancelEditProjectCommand}" 
       Width="100" Height="40" 
 Background="#546E7A" Foreground="White" 
     BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
<Button.Resources>
 <Style TargetType="Border">
    <Setter Property="CornerRadius" Value="5"/>
          </Style>
     </Button.Resources>
 </Button>

         <Button Content="Save" 
       Command="{Binding SaveEditProjectCommand}" 
           Width="100" Height="40" 
      Background="#26A69A" Foreground="White" 
        BorderThickness="0" Cursor="Hand">
      <Button.Resources>
        <Style TargetType="Border">
     <Setter Property="CornerRadius" Value="5"/>
      </Style>
        </Button.Resources>
     </Button>
 </StackPanel>
        </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
