<Window x:Class="TaskForge.WPF.SubscriptionSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:TaskForge.WPF.Converters"
     xmlns:vm="clr-namespace:TaskForge.WPF.ViewModels"
        Title="Керування Підписками" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#222531"
    Loaded="Window_Loaded">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <!-- Main Content Grid -->
        <Grid Margin="40,30,40,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Керування Підписками" FontSize="28" Foreground="White" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="Додати підписку" 
             Command="{Binding AddSubscriptionCommand}"
       Width="150" Height="40"
     Background="#4DB6AC" 
             Foreground="White"
      FontSize="14"
 BorderThickness="0"
                    Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Summary Cards Section -->
            <Grid Grid.Row="1" Margin="0,0,0,30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Monthly Cost Card -->
                <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Height="140">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Місячна вартість" Style="{StaticResource CardHeaderTextStyle}"/>
                        <TextBlock Text="{Binding TotalMonthlyCost, StringFormat='{}{0:N2} ₴'}" 
           FontSize="42" 
     Foreground="#EF5350" 
     FontWeight="Medium" 
     HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Yearly Cost Card -->
                <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Height="140">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Річна вартість" Style="{StaticResource CardHeaderTextStyle}"/>
                        <TextBlock Text="{Binding TotalYearlyCost, StringFormat='{}{0:N2} ₴'}" 
FontSize="42" 
     Foreground="#EF5350" 
  FontWeight="Medium" 
    HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Subscriptions List Header -->
            <TextBlock Grid.Row="2" Text="Ваші підписки" 
          FontSize="20" 
         Foreground="White" 
                 Margin="0,0,0,15"/>

            <!-- Subscriptions Cards Grid -->
            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Subscriptions}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DashboardCardStyle}" MinHeight="220" Margin="8">
                                <Grid Margin="15">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Category Tag -->
                                    <Border Grid.Row="0" 
        Background="#4DB6AC" 
         CornerRadius="10" 
            Padding="10,4" 
           HorizontalAlignment="Left"
          Margin="0,0,0,10">
                                        <TextBlock Text="{Binding IntervalUnit}" 
        Foreground="White" 
         FontSize="11" 
             FontWeight="SemiBold"/>
                                    </Border>

                                    <!-- Subscription Details -->
                                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                                        <!-- Subscription Name -->
                                        <TextBlock Text="{Binding Name}" 
                  FontSize="15" 
                   FontWeight="Bold" 
          Foreground="White" 
      TextTrimming="CharacterEllipsis"
   TextWrapping="NoWrap"
  ToolTip="{Binding Name}"
      Margin="0,0,0,8"/>

                                        <!-- Amount -->
                                        <TextBlock FontSize="20" FontWeight="Bold" Foreground="#EF5350" Margin="0,0,0,10">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="-{0:F2} {1}">
                                                    <Binding Path="Amount"/>
                                                    <Binding Path="Currency"/>
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>

                                        <Separator Background="#3D4255" Height="1" Margin="0,0,0,10"/>

                                        <!-- Billing Cycle -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Цикл: " FontSize="12" Foreground="#78909C"/>
                                            <TextBlock FontSize="12" Foreground="#B0BEC5">
        <Run Text="кожні "/>
          <Run Text="{Binding IntervalValue, Mode=OneWay}"/>
             <Run Text=" "/>
       <Run Text="{Binding IntervalUnit, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Next Billing Date -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Оплата: " FontSize="12" Foreground="#78909C"/>
                                            <TextBlock Text="{Binding BillingDate, StringFormat='{}{0:dd.MM.yyyy}'}" 
          FontSize="12" 
     Foreground="#B0BEC5"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Action Buttons -->
                                    <StackPanel Grid.Row="2" 
            Orientation="Horizontal" 
     HorizontalAlignment="Right" 
         Margin="0,10,0,0">
                                        <!-- Edit Button -->
                                        <Button Style="{StaticResource ActionIconButtonStyle}" 
     Command="{Binding DataContext.OpenEditSubscriptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
        CommandParameter="{Binding Id}"
 ToolTip="Редагувати"
                 Margin="0,0,8,0">
                                            <Path Data="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04c.39-.39.39-1.02 0-1.41l-2.34-2.34c-.39-.39-1.02-.39-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" 
          Fill="#B0BEC5" Stretch="Uniform" Width="16" Height="16"/>
                                        </Button>

                                        <!-- Delete Button -->
                                        <Button Style="{StaticResource ActionIconButtonStyle}" 
   Command="{Binding DataContext.DeleteSubscriptionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
               CommandParameter="{Binding Id}"
      ToolTip="Видалити">
                                            <Path Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z" 
   Fill="#B0BEC5" Stretch="Uniform" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Add Subscription Modal -->
        <Grid x:Name="AddSubscriptionModalOverlay" 
     Visibility="{Binding IsAddSubscriptionModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
Background="#CC000000" Panel.ZIndex="100">
            <Border Background="#2B2F3E" CornerRadius="10" Padding="30" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Додати Підписку" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Назва підписки" Style="{StaticResource ModalLabelStyle}"/>
                    <TextBox Text="{Binding AddSubscriptionName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Вартість" Style="{StaticResource ModalLabelStyle}"/>
                            <TextBox Text="{Binding AddSubscriptionAmount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Валюта" Style="{StaticResource ModalLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Currencies}" 
                SelectedItem="{Binding AddSubscriptionCurrency}" 
      Height="35"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Дата оплати" Style="{StaticResource ModalLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding AddSubscriptionBillingDate}" Height="35"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Інтервал" Style="{StaticResource ModalLabelStyle}"/>
                            <TextBox Text="{Binding AddSubscriptionIntervalValue, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Одиниця" Style="{StaticResource ModalLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding IntervalUnits}" 
      SelectedItem="{Binding AddSubscriptionIntervalUnit}" 
           Height="35"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Скасувати" 
          Command="{Binding CancelAddSubscriptionCommand}" 
            Width="100" Height="40" 
   Background="#546E7A" Foreground="White" 
       BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Зберегти" 
                  Command="{Binding SaveAddSubscriptionCommand}" 
       Width="100" Height="40" 
  Background="#4DB6AC" Foreground="White" 
 BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Edit Subscription Modal -->
        <Grid x:Name="EditSubscriptionModalOverlay" 
           Visibility="{Binding IsEditSubscriptionModalVisible, Converter={StaticResource BoolToVisibilityConverter}}"
 Background="#CC000000" Panel.ZIndex="101">
            <Border Background="#2B2F3E" CornerRadius="10" Padding="30" Width="450" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="Редагувати Підписку" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,0,0,20" HorizontalAlignment="Center"/>

                    <TextBlock Text="Назва підписки" Style="{StaticResource ModalLabelStyle}"/>
                    <TextBox Text="{Binding EditSubscriptionName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Вартість" Style="{StaticResource ModalLabelStyle}"/>
                            <TextBox Text="{Binding EditSubscriptionAmount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Валюта" Style="{StaticResource ModalLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Currencies}" 
       SelectedItem="{Binding EditSubscriptionCurrency}" 
     Height="35"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,0,0,15">
                        <TextBlock Text="Дата оплати" Style="{StaticResource ModalLabelStyle}"/>
                        <DatePicker SelectedDate="{Binding EditSubscriptionBillingDate}" Height="35"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Інтервал" Style="{StaticResource ModalLabelStyle}"/>
                            <TextBox Text="{Binding EditSubscriptionIntervalValue, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Одиниця" Style="{StaticResource ModalLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding IntervalUnits}" 
  SelectedItem="{Binding EditSubscriptionIntervalUnit}" 
 Height="35"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Скасувати" 
   Command="{Binding CancelEditSubscriptionCommand}" 
       Width="100" Height="40" 
          Background="#546E7A" Foreground="White" 
      BorderThickness="0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Content="Зберегти зміни" 
      Command="{Binding SaveEditSubscriptionCommand}" 
           Width="120" Height="40" 
     Background="#4DB6AC" Foreground="White" 
         BorderThickness="0" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>